From 9b1419e1055ea7c8284a833e42f055822a1f0f0e Mon Sep 17 00:00:00 2001
From: exploitizm <351399878+exploitizm@users.noreply.github.com>
Date: Fri, 6 Nov 2026 21:37:22 +1000
Subject: [PATCH] radv/ps5: mesh experiment 0x800000 with 0x2000000, mesh
 workgroups one at a time

Run 21:34 (0x86008001), the exports captured: the workgroup that hangs in
the third chunk is the same meshlet, byte for byte, as one that passed in
the second, and the third chunk's later records never started. A subgroup
completes alone or last in its draw and deadlocks with another queued behind
it (the klog: SPI, SX and PA busy). With 0x800000 and 0x2000000 every mesh
workgroup is a DRAW_INDIRECT of its own, 64 a chunk (the prepass leaves those
past its count without vertices), with an idle wait after each.

Also: the experiment mask is cached in 64 bits, as a mask with bit 31 read
negative and was read again at every call.
---
 src/amd/common/nir/ac_nir_lower_ngg_mesh.c |  4 ++--
 src/amd/vulkan/nir/radv_meta_nir.c         | 14 ++++++++++++++
 src/amd/vulkan/radv_cmd_buffer.c           | 22 ++++++++++++++++++++--
 3 files changed, 36 insertions(+), 4 deletions(-)

diff --git a/src/amd/common/nir/ac_nir_lower_ngg_mesh.c b/src/amd/common/nir/ac_nir_lower_ngg_mesh.c
index 531e6ae..4877711 100644
--- a/src/amd/common/nir/ac_nir_lower_ngg_mesh.c
+++ b/src/amd/common/nir/ac_nir_lower_ngg_mesh.c
@@ -38,7 +38,7 @@
 unsigned
 ac_ps5_mesh_experiments(void)
 {
-   static int mask = -1;
+   static int64_t mask = -1;
    if (mask < 0) {
       unsigned value = 0;
       FILE *f = fopen("/data/eglantineps5/radv-task-emu.txt", "r");
@@ -48,7 +48,7 @@ ac_ps5_mesh_experiments(void)
             value = (unsigned)strtoul(text, NULL, 16);
          fclose(f);
       }
-      mask = (int)value;
+      mask = (int64_t)value;
    }
    return (unsigned)mask;
 }
diff --git a/src/amd/vulkan/nir/radv_meta_nir.c b/src/amd/vulkan/nir/radv_meta_nir.c
index edf9389..f0e020b 100644
--- a/src/amd/vulkan/nir/radv_meta_nir.c
+++ b/src/amd/vulkan/nir/radv_meta_nir.c
@@ -1548,6 +1548,20 @@ radv_meta_nir_build_mesh_draw_records_cs(void)
          }
          nir_pop_loop(&b, NULL);
          nir_build_store_global(&b, nir_load_var(&b, split_slots), count_out, .align_mul = 4);
+         /* Records past the count draw nothing: their vertex count 0, to 64 (the serialized
+          * draws, radv_task_emu_draw_chunk, experiment 0x800000). */
+         nir_variable *zero_slot = nir_local_variable_create(b.impl, glsl_uint_type(), "split_zero");
+         nir_store_var(&b, zero_slot, nir_load_var(&b, split_slots), 0x1);
+         nir_push_loop(&b);
+         {
+            nir_def *z = nir_load_var(&b, zero_slot);
+            nir_break_if(&b, nir_uge_imm(&b, z, 64));
+            nir_build_store_global(&b, nir_imm_int(&b, 0),
+                                   nir_iadd(&b, records_addr, nir_u2u64(&b, nir_imul_imm(&b, z, sizeof(struct radv_mesh_draw_record)))),
+                                   .align_mul = 4);
+            nir_store_var(&b, zero_slot, nir_iadd_imm(&b, z, 1), 0x1);
+         }
+         nir_pop_loop(&b, NULL);
       }
       nir_pop_if(&b, NULL);
    }
diff --git a/src/amd/vulkan/radv_cmd_buffer.c b/src/amd/vulkan/radv_cmd_buffer.c
index d2efd0e..b289c9a 100644
--- a/src/amd/vulkan/radv_cmd_buffer.c
+++ b/src/amd/vulkan/radv_cmd_buffer.c
@@ -15461,7 +15461,7 @@ extern uint64_t radv_ps5_task_emu_note[8];
 uint32_t
 radv_ps5_task_emu_debug(void)
 {
-   static int mask = -1;
+   static int64_t mask = -1;
    if (mask < 0) {
       unsigned value = 0;
       FILE *f = fopen("/data/eglantineps5/radv-task-emu.txt", "r");
@@ -15472,7 +15472,7 @@ radv_ps5_task_emu_debug(void)
          fclose(f);
       }
       fprintf(stderr, "radv/ps5 task-emu: experiments 0x%x\n", value);
-      mask = (int)value;
+      mask = (int64_t)value;
    }
    return (uint32_t)mask;
 }
@@ -15685,6 +15685,24 @@ radv_task_emu_draw_chunk(struct radv_cmd_buffer *cmd_buffer, const struct radv_t
    const bool skip_first = (experiments & 0x1000000) && p_atomic_inc_return(&chunks_drawn) == 1;
    if (skip_first) {
       /* nothing */
+   } else if (!(experiments & 8) && (experiments & 0x800000) && radv_task_emu_splits(device, (uint32_t)emu->rings_va) &&
+              cmd_buffer->state.uses_drawid) {
+      /* Experiments 0x800000 with 0x2000000: a mesh workgroup a draw, 64 of them (the prepass
+       * leaves those past its count drawing nothing), each waited for before the next. */
+      const uint32_t draw_id_reg = cmd_buffer->state.vtx_base_sgpr + 4;
+      radv_emit_userdata_address(device, cs, mesh_shader, AC_UD_VS_MS_DRAW_RECORDS, emu->records_va);
+      for (uint32_t i = 0; i < 64; i++) {
+         radeon_check_space(device->ws, cs->b, 64);
+         radv_emit_indirect_buffer(cs, emu->records_va + i * sizeof(struct radv_mesh_draw_record), false);
+         radeon_begin(cs);
+         radeon_set_sh_reg(draw_id_reg, i);
+         radeon_end();
+         radv_cs_emit_indirect_draw_packet(cmd_buffer, false, 1, 0, sizeof(struct radv_mesh_draw_record), false);
+         cmd_buffer->state.flush_bits |= RADV_CMD_FLAG_PS_PARTIAL_FLUSH | RADV_CMD_FLAG_VS_PARTIAL_FLUSH |
+                                         RADV_CMD_FLAG_CS_PARTIAL_FLUSH | RADV_CMD_FLAG_FLUSH_AND_INV_CB |
+                                         RADV_CMD_FLAG_FLUSH_AND_INV_DB;
+         radv_emit_cache_flush(cmd_buffer);
+      }
    } else if (!(experiments & 8) && (experiments & 0x800000) && !count_va && count <= 64 &&
        cmd_buffer->state.uses_drawid && !radv_task_emu_compacts(device, (uint32_t)emu->rings_va)) {
       /* Experiment 0x800000: a DRAW_INDIRECT per record in place of one DRAW_INDIRECT_MULTI,
-- 
