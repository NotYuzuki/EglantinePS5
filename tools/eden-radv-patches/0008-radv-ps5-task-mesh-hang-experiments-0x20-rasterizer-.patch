From c744ab7df5fafec074557855003390d0e86ecf5e Mon Sep 17 00:00:00 2001
From: exploitizm <351399878+exploitizm@users.noreply.github.com>
Date: Fri, 6 Nov 2026 14:21:39 +1000
Subject: [PATCH] radv/ps5: task+mesh hang experiments 0x20 (rasterizer kill)
 and 0x40 (mesh-done marker)

0x40: after each emulated task chunk's mesh draw, VS_PARTIAL_FLUSH, then
WRITE_DATA a marker and WAIT_REG_MEM on it, so a stall dump stopping there
says the mesh shaders never finished and one stopping at a later end-of-pipe
wait says they did. 0x20: rasterization killed during emulated task draws.
---
 src/amd/vulkan/radv_cmd_buffer.c | 25 +++++++++++++++++++++++--
 1 file changed, 23 insertions(+), 2 deletions(-)

diff --git a/src/amd/vulkan/radv_cmd_buffer.c b/src/amd/vulkan/radv_cmd_buffer.c
index b9bb848..7c17561 100644
--- a/src/amd/vulkan/radv_cmd_buffer.c
+++ b/src/amd/vulkan/radv_cmd_buffer.c
@@ -15443,7 +15443,9 @@ extern uint64_t radv_ps5_task_emu_note[8];
  * mask): 1 waits for the GPU to go idle after each chunk's mesh draw, 2 turns occlusion counting
  * off during emulated task draws, 8 leaves the mesh draws out (the task dispatches and the records
  * prepass still run), 0x10 launches at most one mesh workgroup per task workgroup
- * (radv_meta_mesh_draw_records). */
+ * (radv_meta_mesh_draw_records), 0x20 kills rasterization during emulated task draws, 0x40 waits
+ * for the mesh shaders after each chunk's mesh draw and then writes and waits on a marker, so a
+ * stall dump stopping at that marker says the mesh shaders never finished. */
 uint32_t
 radv_ps5_task_emu_debug(void)
 {
@@ -15632,6 +15634,17 @@ radv_task_emu_draw_chunk(struct radv_cmd_buffer *cmd_buffer, const struct radv_t
       radv_cs_emit_indirect_draw_packet(cmd_buffer, false, count, count_va, sizeof(struct radv_mesh_draw_record),
                                         true);
    }
+   if (experiments & 0x40) {
+      static uint32_t marker;
+      const uint32_t value = ++marker;
+      const uint64_t marker_va = radv_buffer_get_va(device->task_emu_bo) + RADV_TASK_EMU_BYTES - 16;
+      radeon_check_space(device->ws, cs->b, 32);
+      radeon_begin(cs);
+      radeon_event_write(V_028A90_VS_PARTIAL_FLUSH);
+      radeon_end();
+      radv_cs_write_data(device, cs, V_371_MICRO_ENGINE, marker_va, 1, &value, false);
+      radv_cp_wait_mem(cs, WAIT_REG_MEM_EQUAL, marker_va, value, 0xffffffff);
+   }
    if (experiments & 1) {
       cmd_buffer->state.flush_bits |= RADV_CMD_FLAG_PS_PARTIAL_FLUSH | RADV_CMD_FLAG_VS_PARTIAL_FLUSH |
                                       RADV_CMD_FLAG_CS_PARTIAL_FLUSH | RADV_CMD_FLAG_FLUSH_AND_INV_CB |
@@ -15649,6 +15662,14 @@ radv_task_emu_draw_chunk(struct radv_cmd_buffer *cmd_buffer, const struct radv_t
 static void
 radv_task_emu_occlusion_off(struct radv_cmd_buffer *cmd_buffer)
 {
+   if (radv_ps5_task_emu_debug() & 0x20) {
+      struct radv_dynamic_state *d = &cmd_buffer->state.dynamic;
+      const bool discard = d->vk.rs.rasterizer_discard_enable;
+      d->vk.rs.rasterizer_discard_enable = true;
+      radeon_check_space(radv_cmd_buffer_device(cmd_buffer)->ws, cmd_buffer->cs->b, 32);
+      radv_emit_raster_state(cmd_buffer);
+      d->vk.rs.rasterizer_discard_enable = discard;
+   }
    if (!(radv_ps5_task_emu_debug() & 2))
       return;
    const unsigned active = cmd_buffer->state.active_occlusion_queries;
@@ -15665,7 +15686,7 @@ radv_task_emu_occlusion_off(struct radv_cmd_buffer *cmd_buffer)
 static void
 radv_task_emu_end(struct radv_cmd_buffer *cmd_buffer)
 {
-   cmd_buffer->state.dirty |= RADV_CMD_DIRTY_OCCLUSION_QUERY;
+   cmd_buffer->state.dirty |= RADV_CMD_DIRTY_OCCLUSION_QUERY | RADV_CMD_DIRTY_RASTER_STATE;
    cmd_buffer->state.dirty |= RADV_CMD_DIRTY_COMPUTE_PIPELINE | RADV_CMD_DIRTY_RAY_TRACING_PIPELINE;
    radv_mark_descriptors_dirty(cmd_buffer, VK_PIPELINE_BIND_POINT_COMPUTE);
    radv_mark_descriptors_dirty(cmd_buffer, VK_PIPELINE_BIND_POINT_RAY_TRACING_KHR);
-- 
