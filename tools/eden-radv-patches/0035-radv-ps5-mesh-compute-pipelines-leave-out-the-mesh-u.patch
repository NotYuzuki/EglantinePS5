From 26807908f5d893c48af189a1ae7163e84140635a Mon Sep 17 00:00:00 2001
From: exploitizm <351399878+exploitizm@users.noreply.github.com>
Date: Fri, 6 Nov 2026 23:15:46 +1000
Subject: [PATCH] radv/ps5: mesh compute pipelines leave out the mesh-useless
 dynamic states

The mesh stage becomes a compute pass, so radv_pipeline_has_stage(MESH) is
false and pipeline init read the input assembly state a mesh pipeline lacks
(a null dereference on Ocarina's first such pipeline). Decide by the API
stages too.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/amd/vulkan/radv_pipeline_graphics.c | 9 +++++++--
 1 file changed, 7 insertions(+), 2 deletions(-)

diff --git a/src/amd/vulkan/radv_pipeline_graphics.c b/src/amd/vulkan/radv_pipeline_graphics.c
index 86e8621..80f526d 100644
--- a/src/amd/vulkan/radv_pipeline_graphics.c
+++ b/src/amd/vulkan/radv_pipeline_graphics.c
@@ -378,8 +378,13 @@ radv_pipeline_needed_dynamic_state(const struct radv_device *device, const struc
    if (pdev->info.gfx_level < GFX10_3)
       states &= ~RADV_DYNAMIC_FRAGMENT_SHADING_RATE;
 
-   /* Disable dynamic states that are useless to mesh shading. */
-   if (radv_pipeline_has_stage(pipeline, MESA_SHADER_MESH)) {
+   /* Disable dynamic states that are useless to mesh shading. A mesh shader run as compute on the
+    * PS5 (radv_mesh_compute.h) leaves no mesh stage among the pipeline's shaders, only a vertex
+    * shader copying its output, and the pipeline has no input assembly or vertex input state: go by
+    * the API stages.
+    */
+   if (radv_pipeline_has_stage(pipeline, MESA_SHADER_MESH) ||
+       (pipeline->active_stages & VK_SHADER_STAGE_MESH_BIT_EXT)) {
       if (!raster_enabled)
          return RADV_DYNAMIC_RASTERIZER_DISCARD_ENABLE;
 
