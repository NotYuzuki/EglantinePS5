From c43c3b2b74a210ecd9cd9368b1ec8f8244ef451c Mon Sep 17 00:00:00 2001
From: exploitizm <351399878+exploitizm@users.noreply.github.com>
Date: Fri, 6 Nov 2026 15:03:15 +1000
Subject: [PATCH] radv/ps5: mesh experiment 0x200, one null primitive in place
 of none

Run 15:01 (0x81): with every mesh workgroup allocating nothing, which on
GFX10 takes the fully-culled workaround (a dummy primitive from lane 0), the
first emulated task chunk hangs, where with real counts it passes. 0x200
has a mesh workgroup that would allocate nothing allocate one vertex and one
primitive through the ordinary exports, the primitive null (bit 31).
---
 src/amd/common/nir/ac_nir_lower_ngg_mesh.c | 20 +++++++++++++++++++-
 src/amd/vulkan/radv_physical_device.c      |  2 +-
 2 files changed, 20 insertions(+), 2 deletions(-)

diff --git a/src/amd/common/nir/ac_nir_lower_ngg_mesh.c b/src/amd/common/nir/ac_nir_lower_ngg_mesh.c
index b7a1554..5112ddc 100644
--- a/src/amd/common/nir/ac_nir_lower_ngg_mesh.c
+++ b/src/amd/common/nir/ac_nir_lower_ngg_mesh.c
@@ -17,7 +17,9 @@
 /* Task+mesh hang experiments on the PS5 (radv_ps5_task_emu_debug), read once
  * from /data/eglantineps5/radv-task-emu.txt: 0x80 has every mesh workgroup
  * allocate and export nothing, 0x100 keeps its vertices and primitives in
- * its first wave. The RADV cache UUID takes the mask too. */
+ * its first wave, 0x200 has a workgroup that would allocate nothing
+ * allocate one vertex and one null primitive. The RADV cache UUID takes the
+ * mask too. */
 unsigned
 ac_ps5_mesh_experiments(void)
 {
@@ -144,6 +146,9 @@ typedef struct
    bool insert_layer_output;
    /* True if cull flags are used */
    bool uses_cull_flags;
+   /* ac_ps5_mesh_experiments 0x200: the workgroup allocated one null
+    * primitive in place of none. */
+   nir_variable *null_prim_var;
    /* True if the output vertex and primitive counts are workgroup-uniform. */
    bool output_counts_workgroup_uniform;
 
@@ -778,6 +783,14 @@ set_ms_final_output_counts(nir_builder *b,
       num_prm = nir_umin(b, num_prm, nir_imm_int(b, s->wave_size));
       num_vtx = nir_umin(b, num_vtx, nir_imm_int(b, s->wave_size));
    }
+   if ((ac_ps5_mesh_experiments() & 0x200) && !s->prim_parts) {
+      /* No workgroup allocates nothing: one vertex and one null primitive instead. */
+      nir_def *none = nir_ieq_imm(b, num_prm, 0);
+      num_prm = nir_bcsel(b, none, nir_imm_int(b, 1), num_prm);
+      num_vtx = nir_bcsel(b, none, nir_imm_int(b, 1), num_vtx);
+      s->null_prim_var = nir_local_variable_create(b->impl, glsl_bool_type(), "ms_null_prim");
+      nir_store_var(b, s->null_prim_var, none, 0x1);
+   }
 #endif
 
    *out_num_prm = num_prm;
@@ -920,6 +933,11 @@ ms_prim_exp_arg_ch1(nir_builder *b, nir_def *invocation_index, nir_def *num_vtx,
       cull_flag = nir_i2b(b, loaded_cull_flag);
    }
 
+   if (s->null_prim_var) {
+      nir_def *null_prim = nir_load_var(b, s->null_prim_var);
+      cull_flag = cull_flag ? nir_ior(b, cull_flag, null_prim) : null_prim;
+   }
+
    nir_def *indices[3];
    nir_def *max_vtx_idx = nir_iadd_imm(b, num_vtx, -1u);
 
diff --git a/src/amd/vulkan/radv_physical_device.c b/src/amd/vulkan/radv_physical_device.c
index 2badac9..51f3bff 100644
--- a/src/amd/vulkan/radv_physical_device.c
+++ b/src/amd/vulkan/radv_physical_device.c
@@ -395,7 +395,7 @@ radv_device_get_cache_uuid(struct radv_physical_device *pdev, void *uuid)
 #ifdef RADV_PS5
    {
       /* The mesh lowering's experiments change the code (ac_ps5_mesh_experiments). */
-      const unsigned experiments = ac_ps5_mesh_experiments() & 0x180;
+      const unsigned experiments = ac_ps5_mesh_experiments() & 0x380;
       if (experiments)
          _mesa_blake3_update(&ctx, &experiments, sizeof(experiments));
    }
-- 
2.53.0

