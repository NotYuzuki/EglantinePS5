From abc978c0805a8148e25e87a9435bdabe894a3ab9 Mon Sep 17 00:00:00 2001
From: exploitizm <351399878+exploitizm@users.noreply.github.com>
Date: Fri, 6 Nov 2026 20:01:53 +1000
Subject: [PATCH] radv/ps5: mesh experiment 0x10000000, primitives on an
 earlier wave's vertices null

Run 20:01 (0x8008001): primitives exported before vertices do not help.
0x10000000 tests the captured difference directly: only the primitives
that name a vertex an earlier wave of the workgroup exports go out null.
---
 src/amd/common/nir/ac_nir_lower_ngg_mesh.c | 11 ++++++++++-
 src/amd/vulkan/radv_physical_device.c      |  2 +-
 2 files changed, 11 insertions(+), 2 deletions(-)

diff --git a/src/amd/common/nir/ac_nir_lower_ngg_mesh.c b/src/amd/common/nir/ac_nir_lower_ngg_mesh.c
index 9a70fc9..b5a0660 100644
--- a/src/amd/common/nir/ac_nir_lower_ngg_mesh.c
+++ b/src/amd/common/nir/ac_nir_lower_ngg_mesh.c
@@ -30,7 +30,8 @@
  * whole waves (radv_shader_info.c), 0x400000 exports one constant parameter
  * from a shader without any, 0x2000000 adds its record's first_workgroup to
  * a workgroup's index, 0x4000000 captures every wave's exports
- * (ms_ps5_capture_base), 0x8000000 exports primitives before vertices. The
+ * (ms_ps5_capture_base), 0x8000000 exports primitives before vertices,
+ * 0x10000000 nulls the primitives that name a vertex of an earlier wave. The
  * RADV cache UUID takes the mask too. */
 unsigned
 ac_ps5_mesh_experiments(void)
@@ -1020,6 +1021,14 @@ ms_prim_exp_arg_ch1(nir_builder *b, nir_def *invocation_index, nir_def *num_vtx,
 #ifdef RADV_PS5
    if (ac_ps5_mesh_experiments() & 0x40000)
       cull_flag = nir_imm_true(b); /* every primitive null */
+   if (ac_ps5_mesh_experiments() & 0x10000000) {
+      /* Null the primitives that name a vertex an earlier wave exports. */
+      nir_def *wave = nir_udiv_imm(b, invocation_index, s->wave_size);
+      nir_def *earlier = nir_imm_false(b);
+      for (unsigned i = 0; i < s->vertices_per_prim; ++i)
+         earlier = nir_ior(b, earlier, nir_ult(b, nir_udiv_imm(b, nir_channel(b, indices_loaded, i), s->wave_size), wave));
+      cull_flag = cull_flag ? nir_ior(b, cull_flag, earlier) : earlier;
+   }
 #endif
 
    nir_def *indices[3];
diff --git a/src/amd/vulkan/radv_physical_device.c b/src/amd/vulkan/radv_physical_device.c
index d7e9515..6dbdeb1 100644
--- a/src/amd/vulkan/radv_physical_device.c
+++ b/src/amd/vulkan/radv_physical_device.c
@@ -395,7 +395,7 @@ radv_device_get_cache_uuid(struct radv_physical_device *pdev, void *uuid)
 #ifdef RADV_PS5
    {
       /* The mesh lowering's experiments change the code (ac_ps5_mesh_experiments). */
-      const unsigned experiments = ac_ps5_mesh_experiments() & 0xe569b80;
+      const unsigned experiments = ac_ps5_mesh_experiments() & 0x1e569b80;
       if (experiments)
          _mesa_blake3_update(&ctx, &experiments, sizeof(experiments));
    }
-- 
