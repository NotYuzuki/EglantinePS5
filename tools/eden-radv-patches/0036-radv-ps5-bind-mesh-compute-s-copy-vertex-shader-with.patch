From 0c9925466565b6936686da3026c986659de68fa6 Mon Sep 17 00:00:00 2001
From: exploitizm <351399878+exploitizm@users.noreply.github.com>
Date: Sat, 7 Nov 2026 00:10:17 +1000
Subject: [PATCH] radv/ps5: bind mesh compute's copy vertex shader with its
 pipeline

Run 00:08 crashed after 38 minutes in radv_emit_ps_inputs with no last VGT
shader. A pipeline binds the shaders of its API stages, and the copy
vertex shader is in none: it was bound only when the previous pipeline had
a vertex stage, and after another mesh compute pipeline that one's copy
stayed bound. Binding and unbinding include the vertex stage now.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/amd/vulkan/radv_cmd_buffer.c | 17 ++++++++++++++---
 1 file changed, 14 insertions(+), 3 deletions(-)

diff --git a/src/amd/vulkan/radv_cmd_buffer.c b/src/amd/vulkan/radv_cmd_buffer.c
index 7e3b5f7..8ba4178 100644
--- a/src/amd/vulkan/radv_cmd_buffer.c
+++ b/src/amd/vulkan/radv_cmd_buffer.c
@@ -9289,6 +9289,17 @@ radv_bind_rt_pipeline(struct radv_cmd_buffer *cmd_buffer, struct radv_ray_tracin
       cmd_buffer->state.rt_stack_size = rt_pipeline->stack_size;
 }
 
+/* The stages whose shaders a pipeline binds: its API stages, and for a mesh shader run as compute
+ * on the PS5 (radv_mesh_compute.h) the vertex shader copying its output, which no API stage names.
+ * Without it the copy stayed unbound after a pipeline with no vertex shader (a null last VGT shader
+ * at the next draw) and the previous copy stayed bound after another such pipeline.
+ */
+static VkShaderStageFlags
+radv_graphics_pipeline_bound_stages(const struct radv_graphics_pipeline *pipeline)
+{
+   return pipeline->active_stages | (pipeline->base.mesh_compute ? VK_SHADER_STAGE_VERTEX_BIT : 0);
+}
+
 static ALWAYS_INLINE void
 radv_bind_graphics_pipeline(struct radv_cmd_buffer *cmd_buffer, struct radv_graphics_pipeline *graphics_pipeline)
 {
@@ -9300,8 +9311,8 @@ radv_bind_graphics_pipeline(struct radv_cmd_buffer *cmd_buffer, struct radv_grap
    if (cmd_buffer->state.graphics_pipeline == graphics_pipeline)
       return;
 
-   radv_foreach_stage (
-      stage, (cmd_buffer->state.active_stages | graphics_pipeline->active_stages) & RADV_GRAPHICS_STAGE_BITS) {
+   radv_foreach_stage (stage, (cmd_buffer->state.active_stages | radv_graphics_pipeline_bound_stages(graphics_pipeline)) &
+                                 RADV_GRAPHICS_STAGE_BITS) {
       radv_bind_shader(cmd_buffer, graphics_pipeline->base.shaders[stage], stage);
    }
 
@@ -18638,7 +18649,7 @@ radv_reset_pipeline_state(struct radv_cmd_buffer *cmd_buffer, VkPipelineBindPoin
       break;
    case VK_PIPELINE_BIND_POINT_GRAPHICS:
       if (cmd_buffer->state.graphics_pipeline) {
-         radv_foreach_stage (s, cmd_buffer->state.graphics_pipeline->active_stages) {
+         radv_foreach_stage (s, radv_graphics_pipeline_bound_stages(cmd_buffer->state.graphics_pipeline)) {
             radv_bind_shader(cmd_buffer, NULL, s);
          }
          cmd_buffer->state.graphics_pipeline = NULL;
-- 
