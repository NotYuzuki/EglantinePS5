From b98c8fa5d52eb8c48dbe8fc6274d46708abbba55 Mon Sep 17 00:00:00 2001
From: exploitizm <351399878+exploitizm@users.noreply.github.com>
Date: Fri, 6 Nov 2026 16:47:31 +1000
Subject: [PATCH] radv/ps5: mesh experiments 0x20000 (positions 0,0,0,1) and
 0x40000 (primitives null)

Run 16:45 (0x18001): with the empty records left out, the stuck chunk's
draw was one record of 11 workgroups; all 11 started and their 44 waves
ended, and the draw still never reached end-of-pipe. So the empty records
were not it. 0x20000 and 0x40000 take the geometry out of the exports.
---
 src/amd/common/nir/ac_nir_lower_ngg_mesh.c | 14 +++++++++++++-
 src/amd/vulkan/radv_physical_device.c      |  2 +-
 2 files changed, 14 insertions(+), 2 deletions(-)

diff --git a/src/amd/common/nir/ac_nir_lower_ngg_mesh.c b/src/amd/common/nir/ac_nir_lower_ngg_mesh.c
index afd909c..ad608ac 100644
--- a/src/amd/common/nir/ac_nir_lower_ngg_mesh.c
+++ b/src/amd/common/nir/ac_nir_lower_ngg_mesh.c
@@ -24,7 +24,8 @@
  * primitive count null, 0x1000 exports no position component that is not
  * finite, 0x8000 counts at the end of the task emulation buffer the
  * workgroups that start, and the waves that reach the finale and its end
- * (ms_ps5_count). The RADV cache UUID takes the mask too. */
+ * (ms_ps5_count), 0x20000 exports every position as (0, 0, 0, 1), 0x40000
+ * every primitive null. The RADV cache UUID takes the mask too. */
 unsigned
 ac_ps5_mesh_experiments(void)
 {
@@ -970,6 +971,10 @@ ms_prim_exp_arg_ch1(nir_builder *b, nir_def *invocation_index, nir_def *num_vtx,
       nir_def *past = nir_uge(b, invocation_index, nir_load_var(b, s->real_prm_var));
       cull_flag = cull_flag ? nir_ior(b, cull_flag, past) : past;
    }
+#ifdef RADV_PS5
+   if (ac_ps5_mesh_experiments() & 0x40000)
+      cull_flag = nir_imm_true(b); /* every primitive null */
+#endif
 
    nir_def *indices[3];
    nir_def *max_vtx_idx = nir_iadd_imm(b, num_vtx, -1u);
@@ -1071,6 +1076,13 @@ emit_ms_vertex(nir_builder *b, nir_def *index, nir_def *row, bool exports, bool
    ms_emit_arrayed_outputs(b, index, per_vertex_outputs, s);
 
 #ifdef RADV_PS5
+   if (exports && (ac_ps5_mesh_experiments() & 0x20000)) {
+      /* Every position (0, 0, 0, 1). */
+      for (unsigned c = 0; c < 4; c++) {
+         if (s->out.outputs[VARYING_SLOT_POS][c] && s->out.outputs[VARYING_SLOT_POS][c]->bit_size == 32)
+            s->out.outputs[VARYING_SLOT_POS][c] = nir_imm_float(b, c == 3 ? 1.0f : 0.0f);
+      }
+   }
    if (exports && (ac_ps5_mesh_experiments() & 0x1000)) {
       /* No position component that is not finite: 0, or 1 for w. */
       for (unsigned c = 0; c < 4; c++) {
diff --git a/src/amd/vulkan/radv_physical_device.c b/src/amd/vulkan/radv_physical_device.c
index 1e36186..958567f 100644
--- a/src/amd/vulkan/radv_physical_device.c
+++ b/src/amd/vulkan/radv_physical_device.c
@@ -395,7 +395,7 @@ radv_device_get_cache_uuid(struct radv_physical_device *pdev, void *uuid)
 #ifdef RADV_PS5
    {
       /* The mesh lowering's experiments change the code (ac_ps5_mesh_experiments). */
-      const unsigned experiments = ac_ps5_mesh_experiments() & 0x9b80;
+      const unsigned experiments = ac_ps5_mesh_experiments() & 0x69b80;
       if (experiments)
          _mesa_blake3_update(&ctx, &experiments, sizeof(experiments));
    }
-- 
2.53.0

