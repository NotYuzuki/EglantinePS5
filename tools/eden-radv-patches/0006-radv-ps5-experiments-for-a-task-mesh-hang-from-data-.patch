From 523c42ba502544863a44f67e64c4ac6d2c3a14a4 Mon Sep 17 00:00:00 2001
From: exploitizm <351399878+exploitizm@users.noreply.github.com>
Date: Fri, 6 Nov 2026 13:47:58 +1000
Subject: [PATCH] radv/ps5: experiments for a task+mesh hang, from
 /data/eglantineps5/radv-task-emu.txt

A hex mask read once: 1 waits for the GPU to go idle after each emulated
task chunk's mesh draw (so a stall dump names the chunk), 2 turns occlusion
counting off during emulated task draws, 8 leaves their mesh draws out while
the task dispatches and records prepass still run. No file: as before.
---
 src/amd/vulkan/radv_cmd_buffer.c | 66 ++++++++++++++++++++++++++++++--
 1 file changed, 63 insertions(+), 3 deletions(-)

diff --git a/src/amd/vulkan/radv_cmd_buffer.c b/src/amd/vulkan/radv_cmd_buffer.c
index 89c8e8d..4fae98c 100644
--- a/src/amd/vulkan/radv_cmd_buffer.c
+++ b/src/amd/vulkan/radv_cmd_buffer.c
@@ -15434,9 +15434,39 @@ struct radv_task_emu {
 #ifdef RADV_PS5
 #include <inttypes.h>
 #include <stdio.h>
+#include <stdlib.h>
 #include "util/u_atomic.h"
 /* radv_ps5_winsys.c: what its stall dump shows of the last emulated task draw. */
 extern uint64_t radv_ps5_task_emu_note[8];
+
+/* Experiments for a task+mesh hang, read once from /data/eglantineps5/radv-task-emu.txt (a hex
+ * mask): 1 waits for the GPU to go idle after each chunk's mesh draw, 2 turns occlusion counting
+ * off during emulated task draws, 8 leaves the mesh draws out (the task dispatches and the records
+ * prepass still run). */
+static uint32_t
+radv_ps5_task_emu_debug(void)
+{
+   static int mask = -1;
+   if (mask < 0) {
+      unsigned value = 0;
+      FILE *f = fopen("/data/eglantineps5/radv-task-emu.txt", "r");
+      if (f) {
+         char text[16] = {0};
+         if (fread(text, 1, sizeof(text) - 1, f) > 0)
+            value = (unsigned)strtoul(text, NULL, 16);
+         fclose(f);
+      }
+      fprintf(stderr, "radv/ps5 task-emu: experiments 0x%x\n", value);
+      mask = (int)value;
+   }
+   return (uint32_t)mask;
+}
+#else
+static inline uint32_t
+radv_ps5_task_emu_debug(void)
+{
+   return 0;
+}
 #endif
 
 static bool
@@ -15593,20 +15623,48 @@ radv_task_emu_draw_chunk(struct radv_cmd_buffer *cmd_buffer, const struct radv_t
                                (uint32_t)emu->rings_va, draw_id);
    radv_emit_cache_flush(cmd_buffer);
 
+   const uint32_t experiments = radv_ps5_task_emu_debug();
    radeon_check_space(device->ws, cs->b, 64);
-   radv_emit_indirect_buffer(cs, emu->records_va, false);
-   radv_emit_userdata_address(device, cs, mesh_shader, AC_UD_VS_MS_DRAW_RECORDS, emu->records_va);
-   radv_cs_emit_indirect_draw_packet(cmd_buffer, false, count, count_va, sizeof(struct radv_mesh_draw_record), true);
+   if (!(experiments & 8)) {
+      radv_emit_indirect_buffer(cs, emu->records_va, false);
+      radv_emit_userdata_address(device, cs, mesh_shader, AC_UD_VS_MS_DRAW_RECORDS, emu->records_va);
+      radv_cs_emit_indirect_draw_packet(cmd_buffer, false, count, count_va, sizeof(struct radv_mesh_draw_record),
+                                        true);
+   }
+   if (experiments & 1) {
+      cmd_buffer->state.flush_bits |= RADV_CMD_FLAG_PS_PARTIAL_FLUSH | RADV_CMD_FLAG_VS_PARTIAL_FLUSH |
+                                      RADV_CMD_FLAG_CS_PARTIAL_FLUSH | RADV_CMD_FLAG_FLUSH_AND_INV_CB |
+                                      RADV_CMD_FLAG_FLUSH_AND_INV_DB;
+      radv_emit_cache_flush(cmd_buffer);
+   }
 
    /* The next chunk writes the rings the mesh shaders read, and starts the
     * publish ring from zero. */
    cmd_buffer->state.flush_bits |= RADV_CMD_FLAG_VS_PARTIAL_FLUSH;
 }
 
+/* Experiment 2 (radv_ps5_task_emu_debug): no occlusion counting during the draw;
+ * radv_task_emu_end leaves the state dirty so the next draw counts again. */
+static void
+radv_task_emu_occlusion_off(struct radv_cmd_buffer *cmd_buffer)
+{
+   if (!(radv_ps5_task_emu_debug() & 2))
+      return;
+   const unsigned active = cmd_buffer->state.active_occlusion_queries;
+   const bool inherited = cmd_buffer->state.inherited_occlusion_queries;
+   cmd_buffer->state.active_occlusion_queries = 0;
+   cmd_buffer->state.inherited_occlusion_queries = false;
+   radeon_check_space(radv_cmd_buffer_device(cmd_buffer)->ws, cmd_buffer->cs->b, 16);
+   radv_emit_occlusion_query_state(cmd_buffer);
+   cmd_buffer->state.active_occlusion_queries = active;
+   cmd_buffer->state.inherited_occlusion_queries = inherited;
+}
+
 /* The application's compute state comes back before its next dispatch. */
 static void
 radv_task_emu_end(struct radv_cmd_buffer *cmd_buffer)
 {
+   cmd_buffer->state.dirty |= RADV_CMD_DIRTY_OCCLUSION_QUERY;
    cmd_buffer->state.dirty |= RADV_CMD_DIRTY_COMPUTE_PIPELINE | RADV_CMD_DIRTY_RAY_TRACING_PIPELINE;
    radv_mark_descriptors_dirty(cmd_buffer, VK_PIPELINE_BIND_POINT_COMPUTE);
    radv_mark_descriptors_dirty(cmd_buffer, VK_PIPELINE_BIND_POINT_RAY_TRACING_KHR);
@@ -15622,6 +15680,7 @@ radv_task_emu_draw_direct(struct radv_cmd_buffer *cmd_buffer, uint32_t x, uint32
 
    if (!radv_task_emu_begin(cmd_buffer, &emu))
       return;
+   radv_task_emu_occlusion_off(cmd_buffer);
 
    const uint32_t workgroups = x * y * z;
    u_foreach_bit (view, view_mask ? view_mask : 1) {
@@ -15653,6 +15712,7 @@ radv_task_emu_draw_indirect(struct radv_cmd_buffer *cmd_buffer, const struct rad
 
    if (!radv_task_emu_begin(cmd_buffer, &emu))
       return;
+   radv_task_emu_occlusion_off(cmd_buffer);
 
    /* Every chunk the task workgroup limit allows (maxTaskWorkGroupTotalCount),
     * set up for a batch of draws at a time. */
-- 
2.53.0

