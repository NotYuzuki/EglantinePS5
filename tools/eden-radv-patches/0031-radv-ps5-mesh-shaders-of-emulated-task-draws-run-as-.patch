diff --git a/src/amd/vulkan/meta/radv_meta_mesh_draw.c b/src/amd/vulkan/meta/radv_meta_mesh_draw.c
index 3c9def7..703619a 100644
--- a/src/amd/vulkan/meta/radv_meta_mesh_draw.c
+++ b/src/amd/vulkan/meta/radv_meta_mesh_draw.c
@@ -94,15 +94,20 @@ radv_meta_mesh_draw_records(struct radv_cmd_buffer *cmd_buffer, uint64_t indirec
    /* The ring is in the 32-bit window. */
    assert(publish_ring >> 32 == 0 || (publish_ring >> 32) == radv_device_physical(device)->info.address32_hi);
    /* The most workgroups a record launches: a task+mesh hang experiment (radv_ps5_task_emu_debug). */
-   const uint32_t limit = task_rings && (radv_ps5_task_emu_debug() & 0x10) ? parts : UINT32_MAX;
+   /* Mesh shaders run as compute (radv_mesh_compute.h): mode 4, the copy draw's vertices a
+    * workgroup in place of the limit. */
+   const uint32_t mesh_compute_vpw = task_rings ? cmd_buffer->state.mesh_compute_vpw : 0;
+   const uint32_t limit = mesh_compute_vpw ? mesh_compute_vpw
+                          : task_rings && (radv_ps5_task_emu_debug() & 0x10) ? parts
+                                                                              : UINT32_MAX;
    /* An emulated task chunk's records leave out its task workgroups without mesh workgroups:
     * the PS5 hangs at a draw without vertices in a DRAW_INDIRECT_MULTI of mesh workgroups. Their
     * count goes to radv_task_emu_count_va, which the draw reads. */
-   const uint64_t count_out = radv_task_emu_compacts(device, task_rings) ? radv_task_emu_count_va(device) : 0;
+   const uint64_t count_out = mesh_compute_vpw || radv_task_emu_compacts(device, task_rings) ? radv_task_emu_count_va(device) : 0;
    const uint32_t constants[16] = {
       indirect_va,    indirect_va >> 32, records_va, records_va >> 32, count_va,   count_va >> 32,
       stride,         max_count,         parts,      publish_ring,     task_rings, task_draw_id,
-      limit,          count_out ? (radv_task_emu_splits(device, task_rings) ? ((radv_ps5_task_emu_debug() & 0x80000000) ? 3u : 2u) : 1u) : 0u, count_out, count_out >> 32,
+      limit,          mesh_compute_vpw ? 4u : count_out ? (radv_task_emu_splits(device, task_rings) ? ((radv_ps5_task_emu_debug() & 0x80000000) ? 3u : 2u) : 1u) : 0u, count_out, count_out >> 32,
    };
    radv_meta_push_constants(cmd_buffer, layout, VK_SHADER_STAGE_COMPUTE_BIT, 0, sizeof(constants), constants);
 
diff --git a/src/amd/vulkan/nir/radv_meta_nir.c b/src/amd/vulkan/nir/radv_meta_nir.c
index f0e020b..a401a77 100644
--- a/src/amd/vulkan/nir/radv_meta_nir.c
+++ b/src/amd/vulkan/nir/radv_meta_nir.c
@@ -1548,6 +1548,19 @@ radv_meta_nir_build_mesh_draw_records_cs(void)
          }
          nir_pop_loop(&b, NULL);
          nir_build_store_global(&b, nir_load_var(&b, split_slots), count_out, .align_mul = 4);
+         /* Mode 4, mesh shaders run as compute (radv_mesh_compute.h): the compute pass's
+          * workgroups, and the copy draw's vertices, limit a workgroup. */
+         nir_push_if(&b, nir_ieq_imm(&b, mode, 4));
+         {
+            nir_def *n = nir_load_var(&b, split_slots);
+            nir_def *limit = nir_load_push_constant(&b, 1, 32, nir_imm_int(&b, 0), .base = 48, .range = 4);
+            nir_build_store_global(&b, nir_vec4(&b, n, nir_imm_int(&b, 1), nir_imm_int(&b, 1), nir_imm_int(&b, 0)),
+                                   nir_iadd_imm(&b, count_out, 16), .align_mul = 16);
+            nir_build_store_global(&b, nir_vec4(&b, nir_imul(&b, n, limit), nir_imm_int(&b, 1), nir_imm_int(&b, 0),
+                                                nir_imm_int(&b, 0)),
+                                   nir_iadd_imm(&b, count_out, 32), .align_mul = 16);
+         }
+         nir_pop_if(&b, NULL);
          /* Records past the count draw nothing: their vertex count 0, to 64 (the serialized
           * draws, radv_task_emu_draw_chunk, experiment 0x800000). */
          nir_variable *zero_slot = nir_local_variable_create(b.impl, glsl_uint_type(), "split_zero");
diff --git a/src/amd/vulkan/radv_cmd_buffer.c b/src/amd/vulkan/radv_cmd_buffer.c
index b289c9a..7e3b5f7 100644
--- a/src/amd/vulkan/radv_cmd_buffer.c
+++ b/src/amd/vulkan/radv_cmd_buffer.c
@@ -15861,6 +15861,121 @@ radv_task_emu_draw_indirect(struct radv_cmd_buffer *cmd_buffer, const struct rad
    radv_task_emu_end(cmd_buffer);
 }
 
+#ifdef RADV_GS_COMPUTE
+/* The compute pass of a mesh shader run as compute (radv_mesh_compute.h), over the workgroup
+ * counts at indirect_va, with the graphics pipeline's descriptors and push constants. */
+static void
+radv_mesh_compute_dispatch(struct radv_cmd_buffer *cmd_buffer, const struct radv_shader *shader, uint64_t indirect_va)
+{
+   struct radv_device *device = radv_cmd_buffer_device(cmd_buffer);
+   const struct radv_physical_device *pdev = radv_device_physical(device);
+   struct radv_cmd_stream *cs = cmd_buffer->cs;
+
+   radeon_check_space(device->ws, cs->b, 512);
+
+   cmd_buffer->queue_state.compute_scratch_size_per_wave_needed =
+      MAX2(cmd_buffer->queue_state.compute_scratch_size_per_wave_needed, shader->config.scratch_bytes_per_wave);
+   cmd_buffer->queue_state.compute_scratch_waves_wanted =
+      MAX2(cmd_buffer->queue_state.compute_scratch_waves_wanted,
+           radv_get_max_scratch_waves(device, (struct radv_shader *)shader));
+
+   radv_emit_compute_shader(pdev, cs, shader);
+   radv_emit_graphics_stage_for_compute(cmd_buffer, shader);
+
+   /* The compute state is this pass's now (as after radv_task_emu_dispatch). */
+   cmd_buffer->state.dirty |= RADV_CMD_DIRTY_COMPUTE_PIPELINE | RADV_CMD_DIRTY_RAY_TRACING_PIPELINE;
+   radv_mark_descriptors_dirty(cmd_buffer, VK_PIPELINE_BIND_POINT_COMPUTE);
+   radv_mark_descriptors_dirty(cmd_buffer, VK_PIPELINE_BIND_POINT_RAY_TRACING_KHR);
+   cmd_buffer->push_constant_stages |= VK_SHADER_STAGE_COMPUTE_BIT | RADV_RT_STAGE_BITS;
+
+   radv_emit_cache_flush(cmd_buffer);
+
+   const struct radv_dispatch_info info = {
+      .indirect_va = indirect_va,
+   };
+   radv_emit_dispatch_packets(cmd_buffer, shader, &info);
+
+   /* The copy reads the slots. */
+   cmd_buffer->state.flush_bits |= RADV_CMD_FLAG_CS_PARTIAL_FLUSH | RADV_CMD_FLAG_INV_VCACHE | RADV_CMD_FLAG_INV_SCACHE;
+}
+
+/* A direct mesh draw of a pipeline whose mesh shader runs as compute: per chunk of task
+ * workgroups, the task shader, the records prepass (a record a mesh workgroup, with the compute
+ * pass's workgroup count and the copy's vertex count, radv_task_emu_count_va + 16 and + 32), the
+ * compute pass, and the copy's draw, a triangle list. */
+static void
+radv_mesh_compute_draw_direct(struct radv_cmd_buffer *cmd_buffer, uint32_t x, uint32_t y, uint32_t z)
+{
+   struct radv_device *device = radv_cmd_buffer_device(cmd_buffer);
+   const struct radv_pipeline *pipeline = &cmd_buffer->state.graphics_pipeline->base;
+   struct radv_cmd_state *state = &cmd_buffer->state;
+   struct radv_dynamic_state *d = &state->dynamic;
+   const uint32_t workgroups = x * y * z;
+
+   if (!workgroups || !pipeline->mesh_compute || !device->mesh_compute_bo)
+      return;
+
+   if (state->dirty & RADV_CMD_DIRTY_GRAPHICS_SHADERS)
+      radv_bind_graphics_shaders(cmd_buffer);
+
+   struct radv_task_emu emu;
+   if (!radv_task_emu_begin(cmd_buffer, &emu))
+      return;
+
+   radv_cs_add_buffer(device->ws, cmd_buffer->cs->b, device->mesh_compute_bo);
+   const uint64_t args_va = radv_task_emu_count_va(device);
+
+   const uint32_t saved_topology = d->vk.ia.primitive_topology;
+   d->vk.ia.primitive_topology = V_008958_DI_PT_TRILIST;
+   state->dirty_dynamic |= RADV_DYNAMIC_PRIMITIVE_TOPOLOGY;
+   state->dirty |= RADV_CMD_DIRTY_VGT_PRIM_STATE;
+
+   const struct radv_draw_info rast = {
+      .count = 1,
+      .instance_count = 0,
+      .indexed = false,
+      .indirect_va = args_va + 32,
+      .stride = 16,
+   };
+   if (radv_before_draw(cmd_buffer, &rast, 1, false)) {
+      state->mesh_compute_vpw = pipeline->mesh_compute_vertices_per_workgroup;
+      for (uint32_t first = 0; first < workgroups; first += emu.entries) {
+         const uint32_t count = MIN2(emu.entries, workgroups - first);
+         const struct radv_task_emu_block block = {.grid = {x, y, z}, .first_workgroup = first};
+         unsigned offset;
+         if (!radv_cmd_buffer_upload_data(cmd_buffer, sizeof(block), &block, &offset)) {
+            vk_command_buffer_set_error(&cmd_buffer->vk, VK_ERROR_OUT_OF_HOST_MEMORY);
+            break;
+         }
+         radv_task_emu_dispatch(cmd_buffer, &emu, radv_buffer_get_va(cmd_buffer->upload.upload_bo) + offset, count, 0);
+         radv_meta_mesh_draw_records(cmd_buffer, emu.draw_ring_va, AC_TASK_DRAW_ENTRY_BYTES, 0, count, 1, 0,
+                                     emu.records_va, (uint32_t)emu.rings_va, 0);
+         radv_mesh_compute_dispatch(cmd_buffer, pipeline->mesh_compute, args_va + 16);
+         radv_emit_cache_flush(cmd_buffer);
+
+         radeon_check_space(device->ws, cmd_buffer->cs->b, 64);
+         radv_emit_indirect_draw_packets(cmd_buffer, &rast);
+
+         /* The next chunk writes the rings, the records and the slots the copy reads. */
+         state->flush_bits |= RADV_CMD_FLAG_VS_PARTIAL_FLUSH;
+      }
+      state->mesh_compute_vpw = 0;
+      radv_after_draw(cmd_buffer);
+   }
+   radv_task_emu_end(cmd_buffer);
+
+   d->vk.ia.primitive_topology = saved_topology;
+   state->dirty_dynamic |= RADV_DYNAMIC_PRIMITIVE_TOPOLOGY;
+   state->dirty |= RADV_CMD_DIRTY_VGT_PRIM_STATE;
+}
+
+static bool
+radv_mesh_compute_bound(const struct radv_cmd_buffer *cmd_buffer)
+{
+   return cmd_buffer->state.graphics_pipeline && cmd_buffer->state.graphics_pipeline->base.mesh_compute;
+}
+#endif
+
 VKAPI_ATTR void VKAPI_CALL
 radv_CmdDrawMeshTasksEXT(VkCommandBuffer commandBuffer, uint32_t x, uint32_t y, uint32_t z)
 {
@@ -15869,6 +15984,13 @@ radv_CmdDrawMeshTasksEXT(VkCommandBuffer commandBuffer, uint32_t x, uint32_t y,
    struct radv_cmd_stream *cs = cmd_buffer->cs;
    struct radv_draw_info info;
 
+#ifdef RADV_GS_COMPUTE
+   if (radv_mesh_compute_bound(cmd_buffer)) {
+      radv_mesh_compute_draw_direct(cmd_buffer, x, y, z);
+      return;
+   }
+#endif
+
    info.count = x * y * z;
    info.instance_count = 1;
    info.first_instance = 0;
@@ -15900,6 +16022,11 @@ radv_CmdDrawMeshTasksIndirectEXT(VkCommandBuffer commandBuffer, VkBuffer _buffer
    VK_FROM_HANDLE(radv_buffer, buffer, _buffer);
    struct radv_device *device = radv_cmd_buffer_device(cmd_buffer);
    struct radv_cmd_stream *cs = cmd_buffer->cs;
+#ifdef RADV_GS_COMPUTE
+   /* Not yet with a mesh shader run as compute (radv_mesh_compute.h): drawn as nothing. */
+   if (radv_mesh_compute_bound(cmd_buffer))
+      return;
+#endif
 
    radv_cs_add_buffer(device->ws, cs->b, buffer->bo);
 
@@ -15960,6 +16087,11 @@ radv_CmdDrawMeshTasksIndirectCountEXT(VkCommandBuffer commandBuffer, VkBuffer _b
    VK_FROM_HANDLE(radv_buffer, count_buffer, _countBuffer);
    struct radv_device *device = radv_cmd_buffer_device(cmd_buffer);
    struct radv_cmd_stream *cs = cmd_buffer->cs;
+#ifdef RADV_GS_COMPUTE
+   /* Not yet with a mesh shader run as compute (radv_mesh_compute.h): drawn as nothing. */
+   if (radv_mesh_compute_bound(cmd_buffer))
+      return;
+#endif
 
    radv_cs_add_buffer(device->ws, cs->b, buffer->bo);
    radv_cs_add_buffer(device->ws, cs->b, count_buffer->bo);
