From 771487d4ef08e1fbd10d009bc3382cc2fa746f0f Mon Sep 17 00:00:00 2001
From: exploitizm <351399878+exploitizm@users.noreply.github.com>
Date: Fri, 6 Nov 2026 14:49:32 +1000
Subject: [PATCH] radv/ps5: task+mesh hang experiments 0x80 and 0x100 in the
 mesh lowering

Run 14:47 (0x21): with rasterization killed the emulated mesh draw still
never reaches end-of-pipe, after its mesh waves finished. 0x80: every mesh
workgroup allocates and exports nothing; 0x100: its vertices and primitives
stay in its first wave. The mask goes into the cache UUID.
---
 src/amd/common/nir/ac_nir.h                |  6 ++++
 src/amd/common/nir/ac_nir_lower_ngg_mesh.c | 37 ++++++++++++++++++++++
 src/amd/vulkan/radv_cmd_buffer.c           |  3 +-
 src/amd/vulkan/radv_physical_device.c      | 10 ++++++
 4 files changed, 55 insertions(+), 1 deletion(-)

diff --git a/src/amd/common/nir/ac_nir.h b/src/amd/common/nir/ac_nir.h
index a9fbd5f..9303db5 100644
--- a/src/amd/common/nir/ac_nir.h
+++ b/src/amd/common/nir/ac_nir.h
@@ -280,6 +280,12 @@ bool
 ac_nir_lower_ngg_mesh(nir_shader *shader, const ac_nir_lower_ngg_options *options,
                       bool *out_needs_scratch_ring);
 
+#ifdef RADV_PS5
+/* Task+mesh hang experiments on the PS5 (ac_nir_lower_ngg_mesh.c). */
+unsigned
+ac_ps5_mesh_experiments(void);
+#endif
+
 bool
 ac_nir_lower_task_outputs_to_mem(nir_shader *shader,
                                  bool has_query);
diff --git a/src/amd/common/nir/ac_nir_lower_ngg_mesh.c b/src/amd/common/nir/ac_nir_lower_ngg_mesh.c
index 053e1b3..b7a1554 100644
--- a/src/amd/common/nir/ac_nir_lower_ngg_mesh.c
+++ b/src/amd/common/nir/ac_nir_lower_ngg_mesh.c
@@ -10,6 +10,33 @@
 
 #include "nir_builder.h"
 
+#ifdef RADV_PS5
+#include <stdio.h>
+#include <stdlib.h>
+
+/* Task+mesh hang experiments on the PS5 (radv_ps5_task_emu_debug), read once
+ * from /data/eglantineps5/radv-task-emu.txt: 0x80 has every mesh workgroup
+ * allocate and export nothing, 0x100 keeps its vertices and primitives in
+ * its first wave. The RADV cache UUID takes the mask too. */
+unsigned
+ac_ps5_mesh_experiments(void)
+{
+   static int mask = -1;
+   if (mask < 0) {
+      unsigned value = 0;
+      FILE *f = fopen("/data/eglantineps5/radv-task-emu.txt", "r");
+      if (f) {
+         char text[16] = {0};
+         if (fread(text, 1, sizeof(text) - 1, f) > 0)
+            value = (unsigned)strtoul(text, NULL, 16);
+         fclose(f);
+      }
+      mask = (int)value;
+   }
+   return (unsigned)mask;
+}
+#endif
+
 #define SPECIAL_MS_OUT_MASK \
    (VARYING_BIT_PRIMITIVE_COUNT | \
     VARYING_BIT_PRIMITIVE_INDICES | \
@@ -743,6 +770,16 @@ set_ms_final_output_counts(nir_builder *b,
    nir_def *num_prm = nir_load_var(b, s->primitive_count_var);
    nir_def *num_vtx = nir_load_var(b, s->vertex_count_var);
 
+#ifdef RADV_PS5
+   if (ac_ps5_mesh_experiments() & 0x80) {
+      num_prm = nir_imm_int(b, 0);
+      num_vtx = nir_imm_int(b, 0);
+   } else if (ac_ps5_mesh_experiments() & 0x100) {
+      num_prm = nir_umin(b, num_prm, nir_imm_int(b, s->wave_size));
+      num_vtx = nir_umin(b, num_vtx, nir_imm_int(b, s->wave_size));
+   }
+#endif
+
    *out_num_prm = num_prm;
    *out_num_vtx = num_vtx;
 
diff --git a/src/amd/vulkan/radv_cmd_buffer.c b/src/amd/vulkan/radv_cmd_buffer.c
index 7c17561..42b9c8d 100644
--- a/src/amd/vulkan/radv_cmd_buffer.c
+++ b/src/amd/vulkan/radv_cmd_buffer.c
@@ -15445,7 +15445,8 @@ extern uint64_t radv_ps5_task_emu_note[8];
  * prepass still run), 0x10 launches at most one mesh workgroup per task workgroup
  * (radv_meta_mesh_draw_records), 0x20 kills rasterization during emulated task draws, 0x40 waits
  * for the mesh shaders after each chunk's mesh draw and then writes and waits on a marker, so a
- * stall dump stopping at that marker says the mesh shaders never finished. */
+ * stall dump stopping at that marker says the mesh shaders never finished; 0x80 and 0x100 change
+ * the mesh lowering (ac_ps5_mesh_experiments). */
 uint32_t
 radv_ps5_task_emu_debug(void)
 {
diff --git a/src/amd/vulkan/radv_physical_device.c b/src/amd/vulkan/radv_physical_device.c
index c0826e5..2badac9 100644
--- a/src/amd/vulkan/radv_physical_device.c
+++ b/src/amd/vulkan/radv_physical_device.c
@@ -30,6 +30,7 @@
 #include "radv_entrypoints.h"
 #include "radv_instance.h"
 #include "radv_physical_device.h"
+#include "nir/ac_nir.h"
 #include "radv_pipeline_rt.h"
 #include "radv_video.h"
 #include "radv_wsi.h"
@@ -391,6 +392,15 @@ radv_device_get_cache_uuid(struct radv_physical_device *pdev, void *uuid)
       return -1;
 #endif
 
+#ifdef RADV_PS5
+   {
+      /* The mesh lowering's experiments change the code (ac_ps5_mesh_experiments). */
+      const unsigned experiments = ac_ps5_mesh_experiments() & 0x180;
+      if (experiments)
+         _mesa_blake3_update(&ctx, &experiments, sizeof(experiments));
+   }
+#endif
+
    _mesa_blake3_final(&ctx, blake3);
 
    memcpy(uuid, blake3, VK_UUID_SIZE);
-- 
2.53.0

