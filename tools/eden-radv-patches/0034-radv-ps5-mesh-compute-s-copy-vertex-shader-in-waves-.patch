From 714ef0cafa5b821f1c2982a82bcdac53d40c97aa Mon Sep 17 00:00:00 2001
From: exploitizm <351399878+exploitizm@users.noreply.github.com>
Date: Fri, 6 Nov 2026 23:04:09 +1000
Subject: [PATCH] radv/ps5: mesh compute's copy vertex shader in waves of the
 vertex stages' size

Run 23:02: every task and fragment stage of the mesh-compute pipelines
compiled and no copy vertex shader did; ACO spilled it until the heap ran
out. The copy came from nir_builder_init_simple_shader with its subgroup
size 1 to 128, and RADV takes its wave size from the NIR's minimum
(radv_nir_shader_info_pass): waves of 1. It gets the vertex stages' wave
size now (compiler_info->key.ge_wave_size), as SPIR-V's do
(radv_shader_spirv_to_nir).
---
 src/amd/vulkan/radv_mesh_compute.c      | 13 ++++++++++---
 src/amd/vulkan/radv_mesh_compute.h      |  3 ++-
 src/amd/vulkan/radv_pipeline_graphics.c |  2 +-
 3 files changed, 13 insertions(+), 5 deletions(-)

diff --git a/src/amd/vulkan/radv_mesh_compute.c b/src/amd/vulkan/radv_mesh_compute.c
index 76e36d1..6b9321b 100644
--- a/src/amd/vulkan/radv_mesh_compute.c
+++ b/src/amd/vulkan/radv_mesh_compute.c
@@ -103,9 +103,15 @@ vertex_slot(const struct mesh_compute_layout *l, unsigned location)
  * mesh workgroup v / (3 max_primitives); a primitive past its workgroup's count is a triangle of
  * three equal corners, which the rasterizer drops. */
 static nir_shader *
-build_copy_vs(const nir_shader_compiler_options *options, const struct mesh_compute_layout *l)
+build_copy_vs(const nir_shader_compiler_options *options, const struct mesh_compute_layout *l, unsigned wave_size)
 {
    nir_builder b = nir_builder_init_simple_shader(MESA_SHADER_VERTEX, options, "radv_mesh_compute_copy");
+   /* The subgroup size a vertex stage gets from SPIR-V (radv_shader_spirv_to_nir): RADV's wave
+    * size is the NIR's (radv_nir_shader_info_pass), and the builder's 1 to 128 had ACO compile
+    * for waves of 1 and spill without end. */
+   b.shader->info.min_subgroup_size = wave_size;
+   b.shader->info.max_subgroup_size = wave_size;
+   b.shader->info.api_subgroup_size = wave_size;
    const unsigned vpw = l->max_primitives * 3;
 
    nir_def *v = nir_load_vertex_id_zero_base(&b);
@@ -349,7 +355,8 @@ radv_mesh_compute_dump_nir(nir_shader *nir, unsigned n, const char *what)
 static unsigned dump_index;
 
 void
-radv_mesh_compute_split(struct radv_shader_stage *stages, struct radv_mesh_compute_split *out)
+radv_mesh_compute_split(const struct radv_compiler_info *compiler_info, struct radv_shader_stage *stages,
+                        struct radv_mesh_compute_split *out)
 {
    struct radv_shader_stage *ms = &stages[MESA_SHADER_MESH];
    nir_shader *mesh = ms->nir;
@@ -366,7 +373,7 @@ radv_mesh_compute_split(struct radv_shader_stage *stages, struct radv_mesh_compu
 
    const unsigned n = p_atomic_inc_return(&dump_index) - 1;
    radv_mesh_compute_dump_nir(mesh, n, "mesh-in");
-   nir_shader *vs = build_copy_vs(mesh->options, &l);
+   nir_shader *vs = build_copy_vs(mesh->options, &l, compiler_info->key.ge_wave_size);
    lower_mesh_to_compute(mesh, &l);
    radv_mesh_compute_dump_nir(mesh, n, "lowered");
    radv_mesh_compute_dump_nir(vs, n, "copy");
diff --git a/src/amd/vulkan/radv_mesh_compute.h b/src/amd/vulkan/radv_mesh_compute.h
index bedf135..22d92e4 100644
--- a/src/amd/vulkan/radv_mesh_compute.h
+++ b/src/amd/vulkan/radv_mesh_compute.h
@@ -56,7 +56,8 @@ bool radv_mesh_compute_wanted(const struct radv_graphics_state_key *gfx_state,
 
 /* stages[MESA_SHADER_MESH] becomes the compute pass (out->cs) and stages[MESA_SHADER_VERTEX] the
  * copy vertex shader; the mesh stage is left empty. */
-void radv_mesh_compute_split(struct radv_shader_stage *stages, struct radv_mesh_compute_split *out);
+void radv_mesh_compute_split(const struct radv_compiler_info *compiler_info, struct radv_shader_stage *stages,
+                             struct radv_mesh_compute_split *out);
 
 struct radv_shader_binary *radv_mesh_compute_compile(const struct radv_compiler_info *compiler_info,
                                                      struct radv_mesh_compute_split *split,
diff --git a/src/amd/vulkan/radv_pipeline_graphics.c b/src/amd/vulkan/radv_pipeline_graphics.c
index 463ba27..86e8621 100644
--- a/src/amd/vulkan/radv_pipeline_graphics.c
+++ b/src/amd/vulkan/radv_pipeline_graphics.c
@@ -2549,7 +2549,7 @@ radv_graphics_shaders_compile(const struct radv_compiler_info *compiler_info, st
    struct radv_mesh_compute_split mesh_split;
    const bool mesh_compute_used = gs_compute && !gs_compute_used && radv_mesh_compute_wanted(gfx_state, stages);
    if (mesh_compute_used) {
-      radv_mesh_compute_split(stages, &mesh_split);
+      radv_mesh_compute_split(compiler_info, stages, &mesh_split);
       mesh_compute_gfx_state = *gfx_state;
       mesh_compute_gfx_state.ia.topology = V_008958_DI_PT_TRILIST;
       mesh_compute_gfx_state.vs.has_prolog = false;
-- 
2.53.0

