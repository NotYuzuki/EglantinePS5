From 16bb9d56e85a9343dcb108c26f3700563384f773 Mon Sep 17 00:00:00 2001
From: exploitizm <351399878+exploitizm@users.noreply.github.com>
Date: Fri, 6 Nov 2026 22:39:32 +1000
Subject: [PATCH] radv/ps5: mesh compute dumps its shaders' NIR and sizes

Run 22:37 (slice 1): Ocarina ran its task+mesh draws without the GPU
stalling (the stall dump: every submission run), then a pipeline compile
grew the heap to 2.4 GB in 21 million blocks, in ACO's spiller, and the
app ran out of memory. The first four mesh-compute pipelines now write
their shaders' NIR (the mesh shader as split, lowered, the copy, and the
compute pass before ACO) to /data/eglantineps5/logs/mesh-compute-*.nir, and
every one its instruction counts to stderr.
---
 src/amd/vulkan/radv_mesh_compute.c | 34 ++++++++++++++++++++++++++++++
 1 file changed, 34 insertions(+)

diff --git a/src/amd/vulkan/radv_mesh_compute.c b/src/amd/vulkan/radv_mesh_compute.c
index 982c4bf..91bb783 100644
--- a/src/amd/vulkan/radv_mesh_compute.c
+++ b/src/amd/vulkan/radv_mesh_compute.c
@@ -15,6 +15,7 @@
 #include "ac_nir.h"
 #include "util/bitscan.h"
 #include "util/u_math.h"
+#include "util/u_atomic.h"
 
 #include <stdio.h>
 #include <stdlib.h>
@@ -320,6 +321,33 @@ lower_mesh_to_compute(nir_shader *nir, const struct mesh_compute_layout *l)
    NIR_PASS(_, nir, nir_opt_dce);
 }
 
+/* What a shader of this path has become, for the first few pipelines: its instruction count to
+ * stderr and its NIR to /data/eglantineps5/logs/mesh-compute-<n>-<what>.nir. */
+static void
+dump_nir(nir_shader *nir, unsigned n, const char *what)
+{
+   unsigned instrs = 0;
+   nir_foreach_function_impl (impl, nir) {
+      nir_foreach_block (block, impl) {
+         nir_foreach_instr (instr, block)
+            instrs++;
+      }
+   }
+   fprintf(stderr, "radv/ps5 mesh-compute: pipeline %u %s: %u NIR instructions, %u shared bytes, scratch %u\n", n, what,
+           instrs, nir->info.shared_size, nir->scratch_size);
+   if (n >= 4)
+      return;
+   char path[128];
+   snprintf(path, sizeof(path), "/data/eglantineps5/logs/mesh-compute-%u-%s.nir", n, what);
+   FILE *f = fopen(path, "w");
+   if (f) {
+      nir_print_shader(nir, f);
+      fclose(f);
+   }
+}
+
+static unsigned dump_index;
+
 void
 radv_mesh_compute_split(struct radv_shader_stage *stages, struct radv_mesh_compute_split *out)
 {
@@ -336,8 +364,12 @@ radv_mesh_compute_split(struct radv_shader_stage *stages, struct radv_mesh_compu
    l.capacity = MIN2(RADV_MESH_COMPUTE_SLOTS_BYTES / l.stride, RADV_TASK_EMU_MAX_ENTRIES);
    l.payload_stride = align(MAX2(stages[MESA_SHADER_TASK].nir->info.task_payload_size, 16), 16);
 
+   const unsigned n = p_atomic_inc_return(&dump_index) - 1;
+   dump_nir(mesh, n, "mesh-in");
    nir_shader *vs = build_copy_vs(mesh->options, &l);
    lower_mesh_to_compute(mesh, &l);
+   dump_nir(mesh, n, "lowered");
+   dump_nir(vs, n, "copy");
 
    memset(out, 0, sizeof(*out));
    out->mesh_stage = *ms;
@@ -354,6 +386,7 @@ radv_mesh_compute_split(struct radv_shader_stage *stages, struct radv_mesh_compu
    ms->stage = MESA_SHADER_NONE;
 }
 
+
 static const nir_lower_compute_system_values_options compute_sysval_options = {
    .lower_local_invocation_index = true,
    .has_base_global_invocation_id = false,
@@ -404,6 +437,7 @@ radv_mesh_compute_compile(const struct radv_compiler_info *compiler_info, struct
    NIR_PASS(_, nir, nir_lower_compute_system_values, &compute_sysval_options);
    radv_optimize_nir(nir, stage.key.optimisations_disabled);
    radv_postprocess_nir(compiler_info, NULL, &stage);
+   dump_nir(nir, dump_index - 1, "final");
 
    struct radv_shader_binary *binary = radv_shader_nir_to_asm(compiler_info, &stage, &nir, 1, NULL);
    radv_shader_dump_asm(compiler_info, debug, binary, &stage.info);
-- 
2.53.0

