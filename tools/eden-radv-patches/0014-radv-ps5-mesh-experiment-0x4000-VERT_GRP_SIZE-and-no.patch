From 972c76475c6d372c6e5e4980e278d32a8146f18c Mon Sep 17 00:00:00 2001
From: exploitizm <351399878+exploitizm@users.noreply.github.com>
Date: Fri, 6 Nov 2026 15:38:43 +1000
Subject: [PATCH] radv/ps5: mesh experiment 0x4000 (VERT_GRP_SIZE), and no
 stall dump on a GPU merely behind

Run 15:36 (0x1001): the stall dump went at 90 s into shader compilation, on
a GPU one submission behind, and the real hang later had none. The dump on
request now waits a second and gives up when the GPU moved on.

0x4000: GFX10's NGG workaround sets GE_CNTL.VERT_GRP_SIZE to
ES_VERTS_PER_SUBGRP - 5, or 0 at 5 or fewer; mesh shaders (one per subgroup)
get 0 there, where upstream, on GFX10.3 only, they have 1. 0x4000 keeps 1.
---
 src/amd/vulkan/radv_cmd_buffer.c            |  9 +++++++--
 src/amd/vulkan/winsys/ps5/radv_ps5_winsys.c | 16 ++++++++++++++--
 2 files changed, 21 insertions(+), 4 deletions(-)

diff --git a/src/amd/vulkan/radv_cmd_buffer.c b/src/amd/vulkan/radv_cmd_buffer.c
index 42b9c8d..8f72dee 100644
--- a/src/amd/vulkan/radv_cmd_buffer.c
+++ b/src/amd/vulkan/radv_cmd_buffer.c
@@ -3186,7 +3186,11 @@ radv_emit_hw_ngg(struct radv_cmd_buffer *cmd_buffer, const struct radv_shader *e
        *
        * Requirement: GE_CNTL.VERT_GRP_SIZE = VGT_GS_ONCHIP_CNTL.ES_VERTS_PER_SUBGRP - 5
        */
-      if (pdev->info.gfx_level == GFX10 && es_type != MESA_SHADER_TESS_EVAL && ngg_state->hw_max_esverts != 256) {
+      /* Experiment 0x4000 (radv_ps5_task_emu_debug): mesh shaders, which upstream run only on GFX10.3,
+       * keep VERT_GRP_SIZE = 1 as there. */
+      const bool mesh_keeps_grouping = es_type == MESA_SHADER_MESH && (radv_ps5_task_emu_debug() & 0x4000);
+      if (pdev->info.gfx_level == GFX10 && es_type != MESA_SHADER_TESS_EVAL && ngg_state->hw_max_esverts != 256 &&
+          !mesh_keeps_grouping) {
          ge_cntl &= C_03096C_VERT_GRP_SIZE;
 
          if (ngg_state->hw_max_esverts > 5) {
@@ -15446,7 +15450,8 @@ extern uint64_t radv_ps5_task_emu_note[8];
  * (radv_meta_mesh_draw_records), 0x20 kills rasterization during emulated task draws, 0x40 waits
  * for the mesh shaders after each chunk's mesh draw and then writes and waits on a marker, so a
  * stall dump stopping at that marker says the mesh shaders never finished; 0x80 and 0x100 change
- * the mesh lowering (ac_ps5_mesh_experiments). */
+ * the mesh lowering (ac_ps5_mesh_experiments); 0x4000 leaves GE_CNTL.VERT_GRP_SIZE of mesh shaders
+ * out of GFX10's NGG workaround. */
 uint32_t
 radv_ps5_task_emu_debug(void)
 {
diff --git a/src/amd/vulkan/winsys/ps5/radv_ps5_winsys.c b/src/amd/vulkan/winsys/ps5/radv_ps5_winsys.c
index 1d1da11..3f85062 100644
--- a/src/amd/vulkan/winsys/ps5/radv_ps5_winsys.c
+++ b/src/amd/vulkan/winsys/ps5/radv_ps5_winsys.c
@@ -1003,8 +1003,20 @@ radv_ps5_dump_stall_now(void)
    struct radv_ps5_queue *const queue = p_atomic_read(&radv_ps5_queue_instance);
    if (!queue)
       return;
-   const uint64_t completed = radv_ps5_queue_poll(queue);
-   const uint64_t submitted = p_atomic_read(&queue->submitted_seq);
+   uint64_t completed = radv_ps5_queue_poll(queue);
+   uint64_t submitted = p_atomic_read(&queue->submitted_seq);
+   if (completed < submitted) {
+      /* A GPU merely behind (compiling shaders, say) moves on within a second: the dump, which
+       * runs once, is for one that has stopped. */
+      os_time_sleep(1000000);
+      const uint64_t later = radv_ps5_queue_poll(queue);
+      if (later > completed) {
+         fprintf(stderr, "radv/ps5: stall dump asked: the GPU is still running (submission %" PRIu64
+                 " to %" PRIu64 " in a second); not dumping\n", completed, later);
+         return;
+      }
+      submitted = p_atomic_read(&queue->submitted_seq);
+   }
    if (completed >= submitted) {
       fprintf(stderr, "radv/ps5: stall dump asked: the GPU has run every submission (%" PRIu64 ")\n", completed);
       return;
-- 
2.53.0

