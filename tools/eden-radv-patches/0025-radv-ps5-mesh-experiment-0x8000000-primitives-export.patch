From 2792ee406025439a5f242bbb8bbbde1a8a99a560 Mon Sep 17 00:00:00 2001
From: exploitizm <351399878+exploitizm@users.noreply.github.com>
Date: Fri, 6 Nov 2026 19:50:07 +1000
Subject: [PATCH] radv/ps5: mesh experiment 0x8000000, primitives exported
 before vertices

Run 19:47 (0x4008001), the exports captured: the first chunk's four
workgroups, which pass, have no primitive that names a vertex of an earlier
wave; the second chunk's two, which hang, have 4 and 6 (wave 1 primitives on
wave 0 vertices). Indices, counts and positions are otherwise ordinary.

The mesh finale exports each wave's positions, then its primitives; the NGG
GS lowering, which runs on the same GS-mode hardware, exports primitives
first. 0x8000000 does as it does.
---
 src/amd/common/nir/ac_nir_lower_ngg_mesh.c | 18 ++++++++++++++++--
 src/amd/vulkan/radv_physical_device.c      |  2 +-
 2 files changed, 17 insertions(+), 3 deletions(-)

diff --git a/src/amd/common/nir/ac_nir_lower_ngg_mesh.c b/src/amd/common/nir/ac_nir_lower_ngg_mesh.c
index da706cd..9a70fc9 100644
--- a/src/amd/common/nir/ac_nir_lower_ngg_mesh.c
+++ b/src/amd/common/nir/ac_nir_lower_ngg_mesh.c
@@ -30,7 +30,8 @@
  * whole waves (radv_shader_info.c), 0x400000 exports one constant parameter
  * from a shader without any, 0x2000000 adds its record's first_workgroup to
  * a workgroup's index, 0x4000000 captures every wave's exports
- * (ms_ps5_capture_base). The RADV cache UUID takes the mask too. */
+ * (ms_ps5_capture_base), 0x8000000 exports primitives before vertices. The
+ * RADV cache UUID takes the mask too. */
 unsigned
 ac_ps5_mesh_experiments(void)
 {
@@ -1580,6 +1581,19 @@ emit_ms_finale(nir_builder *b, lower_ngg_ms_state *s)
       (per_primitive_outputs & MS_PRIM_ARG_EXP_MASK);
    const bool wait_attr_ring = has_special_param_exports && s->ac->has_attr_ring_wait_bug;
 
+   /* Experiment 0x8000000: primitives before vertices, the order of the NGG GS
+    * lowering (ac_nir_lower_ngg_gs.c, ngg_gs_finale). */
+   bool prims_first = false;
+#ifdef RADV_PS5
+   prims_first = (ac_ps5_mesh_experiments() & 0x8000000) != 0;
+#endif
+
+   /* Export primitives. */
+   if (prims_first && (per_primitive_outputs || !wait_attr_ring)) {
+      emit_ms_outputs(b, invocation_index, row_start, num_prm, !wait_attr_ring, true,
+                      per_primitive_outputs, &emit_ms_primitive, s);
+   }
+
    /* Export vertices. */
    if ((per_vertex_outputs & ~VARYING_BIT_POS) || !wait_attr_ring) {
       emit_ms_outputs(b, invocation_index, row_start, num_vtx, !wait_attr_ring, true,
@@ -1587,7 +1601,7 @@ emit_ms_finale(nir_builder *b, lower_ngg_ms_state *s)
    }
 
    /* Export primitives. */
-   if (per_primitive_outputs || !wait_attr_ring) {
+   if (!prims_first && (per_primitive_outputs || !wait_attr_ring)) {
       emit_ms_outputs(b, invocation_index, row_start, num_prm, !wait_attr_ring, true,
                       per_primitive_outputs, &emit_ms_primitive, s);
    }
diff --git a/src/amd/vulkan/radv_physical_device.c b/src/amd/vulkan/radv_physical_device.c
index aa731de..d7e9515 100644
--- a/src/amd/vulkan/radv_physical_device.c
+++ b/src/amd/vulkan/radv_physical_device.c
@@ -395,7 +395,7 @@ radv_device_get_cache_uuid(struct radv_physical_device *pdev, void *uuid)
 #ifdef RADV_PS5
    {
       /* The mesh lowering's experiments change the code (ac_ps5_mesh_experiments). */
-      const unsigned experiments = ac_ps5_mesh_experiments() & 0x6569b80;
+      const unsigned experiments = ac_ps5_mesh_experiments() & 0xe569b80;
       if (experiments)
          _mesa_blake3_update(&ctx, &experiments, sizeof(experiments));
    }
-- 
