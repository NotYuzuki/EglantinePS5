From def3fa14bd7dc297d9a4f5941fc94733bbcabdfd Mon Sep 17 00:00:00 2001
From: Oliv3rmoon <oliv3rmoon@users.noreply.github.com>
Date: Thu, 29 Oct 2026 12:46:08 -0700
Subject: [PATCH 2/4] radv/ps5: RADV on the PS5 may also split a long command
 stream before a transfer or a barrier.

One AGC submission carries at most about a million words, and each starts from reset GPU state,
so a stream is split only where its state can be re-emitted: radv_split_cmd_stream_if_due, which
RADV called before draws and dispatches only. A game that loads a new area records long runs of
buffer uploads, copies and barriers with hardly a draw between them; such a run grew past one
submission with nowhere to split it, and the winsys gave up ("a submission holds more words
between two splits than one AGC submission can", then VK_ERROR_DEVICE_LOST). The same check now
runs where a transfer command or a barrier starts, under the same conditions as before a draw.
Applied to the driver checkout after patch-radv-disk-cache.py; running it again changes nothing.

From Nightshade tools/patch-radv-transfer-split.py.

(cherry picked from commit 9d73715bd1a4abe9fa3a30d3c4feaacb6cee4123)
---
 src/amd/vulkan/meta/radv_meta_buffer.c | 4 ++++
 src/amd/vulkan/meta/radv_meta_copy.c   | 4 ++++
 src/amd/vulkan/radv_cmd_buffer.c       | 5 ++++-
 3 files changed, 12 insertions(+), 1 deletion(-)

diff --git a/src/amd/vulkan/meta/radv_meta_buffer.c b/src/amd/vulkan/meta/radv_meta_buffer.c
index 559272a..10c7125 100644
--- a/src/amd/vulkan/meta/radv_meta_buffer.c
+++ b/src/amd/vulkan/meta/radv_meta_buffer.c
@@ -11,6 +11,7 @@
 #include "tools/radv_debug_hang.h"
 #include "radv_cp_dma.h"
 #include "radv_meta.h"
+void radv_split_cmd_stream_if_due(struct radv_cmd_buffer *cmd_buffer);
 #include "radv_sdma.h"
 #include "radv_tracepoints.h"
 #include "vk_shader_module.h"
@@ -325,6 +326,7 @@ radv_CmdFillBuffer(VkCommandBuffer commandBuffer, VkBuffer dstBuffer, VkDeviceSi
                    uint32_t data)
 {
    VK_FROM_HANDLE(radv_cmd_buffer, cmd_buffer, commandBuffer);
+   radv_split_cmd_stream_if_due(cmd_buffer); /* ProsperoEden: tools/patch-radv-transfer-split.py */
    VK_FROM_HANDLE(radv_buffer, dst_buffer, dstBuffer);
 
    radv_suspend_conditional_rendering(cmd_buffer);
@@ -381,6 +383,7 @@ VKAPI_ATTR void VKAPI_CALL
 radv_CmdCopyBuffer2(VkCommandBuffer commandBuffer, const VkCopyBufferInfo2 *pCopyBufferInfo)
 {
    VK_FROM_HANDLE(radv_cmd_buffer, cmd_buffer, commandBuffer);
+   radv_split_cmd_stream_if_due(cmd_buffer); /* ProsperoEden: tools/patch-radv-transfer-split.py */
    VK_FROM_HANDLE(radv_buffer, src_buffer, pCopyBufferInfo->srcBuffer);
    VK_FROM_HANDLE(radv_buffer, dst_buffer, pCopyBufferInfo->dstBuffer);
    struct radv_device *device = radv_cmd_buffer_device(cmd_buffer);
@@ -481,6 +484,7 @@ radv_CmdUpdateBuffer(VkCommandBuffer commandBuffer, VkBuffer dstBuffer, VkDevice
                      const void *pData)
 {
    VK_FROM_HANDLE(radv_cmd_buffer, cmd_buffer, commandBuffer);
+   radv_split_cmd_stream_if_due(cmd_buffer); /* ProsperoEden: tools/patch-radv-transfer-split.py */
    VK_FROM_HANDLE(radv_buffer, dst_buffer, dstBuffer);
    struct radv_device *device = radv_cmd_buffer_device(cmd_buffer);
    const uint64_t dst_va = vk_buffer_address(&dst_buffer->vk, dstOffset);
