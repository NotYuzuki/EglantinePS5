From 25631360feea963cef5c7dadd87983fc54c19596 Mon Sep 17 00:00:00 2001
From: exploitizm <351399878+exploitizm@users.noreply.github.com>
Date: Fri, 6 Nov 2026 18:42:50 +1000
Subject: [PATCH] radv/ps5: mesh experiments 0x1000000 (first chunk's draw left
 out) and 0x2000000 (a draw a workgroup)

Run 18:40 (0x808001): a DRAW_INDIRECT per record hangs as the multi draw
did, so the multi draw packet is not it. To isolate the stuck draw, as a
second opinion suggested:

0x1000000 leaves out the first emulated task chunk's mesh draw, so the
second runs without a mesh draw before it.

0x2000000 has the records prepass write a record per mesh workgroup, each
launching one workgroup, its index (first_workgroup) added to the vertex ID
the mesh shader takes as its workgroup index, drawn by count from memory;
0x800000 now stands aside with compaction.
---
 src/amd/common/nir/ac_nir_lower_ngg_mesh.c |  9 +++-
 src/amd/vulkan/meta/radv_meta_mesh_draw.c  |  2 +-
 src/amd/vulkan/nir/radv_meta_nir.c         | 52 ++++++++++++++++++++--
 src/amd/vulkan/radv_cmd_buffer.c           | 24 +++++++---
 src/amd/vulkan/radv_cmd_buffer.h           |  2 +
 src/amd/vulkan/radv_physical_device.c      |  2 +-
 6 files changed, 79 insertions(+), 12 deletions(-)

diff --git a/src/amd/common/nir/ac_nir_lower_ngg_mesh.c b/src/amd/common/nir/ac_nir_lower_ngg_mesh.c
index 4f374b4..58f80d1 100644
--- a/src/amd/common/nir/ac_nir_lower_ngg_mesh.c
+++ b/src/amd/common/nir/ac_nir_lower_ngg_mesh.c
@@ -28,7 +28,8 @@
  * (ms_ps5_count), 0x20000 exports every position as (0, 0, 0, 1), 0x40000
  * every primitive null, 0x100000 rounds the registers' mesh workgroup up to
  * whole waves (radv_shader_info.c), 0x400000 exports one constant parameter
- * from a shader without any. The RADV cache UUID takes the mask too. */
+ * from a shader without any, 0x2000000 adds its record's first_workgroup to
+ * a workgroup's index. The RADV cache UUID takes the mask too. */
 unsigned
 ac_ps5_mesh_experiments(void)
 {
@@ -722,6 +723,12 @@ ms_emit_legacy_workgroup_index(nir_builder *b, lower_ngg_ms_state *s)
     * the first invocation of the first wave. To let other waves know, we use LDS.
     */
    nir_def *workgroup_index = nir_load_vertex_id_zero_base(b);
+#ifdef RADV_PS5
+   /* Experiment 0x2000000: a draw a workgroup, whose index its record carries
+    * (radv_task_emu_splits, in first_workgroup). */
+   if (ac_ps5_mesh_experiments() & 0x2000000)
+      workgroup_index = nir_iadd(b, workgroup_index, nir_u2u32(b, nir_load_ms_publish_first_workgroup_amd(b)));
+#endif
 
    if (s->api_workgroup_size <= s->wave_size && s->hw_workgroup_size <= s->wave_size) {
       /* API workgroup is small, so we don't need to use LDS. */
diff --git a/src/amd/vulkan/meta/radv_meta_mesh_draw.c b/src/amd/vulkan/meta/radv_meta_mesh_draw.c
index 1c75f7e..7edc01c 100644
--- a/src/amd/vulkan/meta/radv_meta_mesh_draw.c
+++ b/src/amd/vulkan/meta/radv_meta_mesh_draw.c
@@ -102,7 +102,7 @@ radv_meta_mesh_draw_records(struct radv_cmd_buffer *cmd_buffer, uint64_t indirec
    const uint32_t constants[16] = {
       indirect_va,    indirect_va >> 32, records_va, records_va >> 32, count_va,   count_va >> 32,
       stride,         max_count,         parts,      publish_ring,     task_rings, task_draw_id,
-      limit,          count_out != 0,    count_out,  count_out >> 32,
+      limit,          count_out ? (radv_task_emu_splits(device, task_rings) ? 2u : 1u) : 0u, count_out, count_out >> 32,
    };
    radv_meta_push_constants(cmd_buffer, layout, VK_SHADER_STAGE_COMPUTE_BIT, 0, sizeof(constants), constants);
 
diff --git a/src/amd/vulkan/nir/radv_meta_nir.c b/src/amd/vulkan/nir/radv_meta_nir.c
index 0a8b763..1cfb78d 100644
--- a/src/amd/vulkan/nir/radv_meta_nir.c
+++ b/src/amd/vulkan/nir/radv_meta_nir.c
@@ -1438,7 +1438,8 @@ radv_meta_nir_build_copy_memory_indirect_preprocess_cs(void)
  */
 static void
 mesh_draw_record(nir_builder *b, nir_def *slot, nir_def *draw, nir_def *records_addr, nir_def *parts, nir_def *ring,
-                 nir_def *first_workgroup, nir_def *grid, nir_def *task_rings, nir_def *task_draw_id)
+                 nir_def *first_workgroup, nir_def *grid, nir_def *task_rings, nir_def *task_draw_id,
+                 nir_def *one_workgroup)
 {
    /* A vertex launches a workgroup, or each of its parts; at most the limit
     * (radv_meta_mesh_draw_records). */
@@ -1447,6 +1448,9 @@ mesh_draw_record(nir_builder *b, nir_def *slot, nir_def *draw, nir_def *records_
                                 nir_imul(b, nir_imul(b, nir_channel(b, grid, 0), nir_channel(b, grid, 1)),
                                          nir_imul(b, nir_channel(b, grid, 2), parts)),
                                 limit);
+   /* Split (radv_task_emu_splits): the record launches one workgroup, first_workgroup. */
+   if (one_workgroup)
+      vertices = parts;
    nir_def *zero = nir_imm_int(b, 0);
 
    nir_def *record_addr =
@@ -1496,7 +1500,8 @@ radv_meta_nir_build_mesh_draw_records_cs(void)
    nir_def *task_rings = nir_load_push_constant(&b, 1, 32, nir_imm_int(&b, 0), .base = 40, .range = 4);
    nir_def *task_draw_id = nir_load_push_constant(&b, 1, 32, nir_imm_int(&b, 0), .base = 44, .range = 4);
    /* Leave out the draws without workgroups, their count at count_out (radv_meta_mesh_draw_records). */
-   nir_def *compact = nir_ine_imm(&b, nir_load_push_constant(&b, 1, 32, nir_imm_int(&b, 0), .base = 52, .range = 4), 0);
+   nir_def *mode = nir_load_push_constant(&b, 1, 32, nir_imm_int(&b, 0), .base = 52, .range = 4);
+   nir_def *compact = nir_ine_imm(&b, mode, 0);
    nir_def *count_out = nir_load_push_constant(&b, 1, 64, nir_imm_int(&b, 0), .base = 56, .range = 8);
 
    /* Only the draws the count buffer has. */
@@ -1505,13 +1510,51 @@ radv_meta_nir_build_mesh_draw_records_cs(void)
    nir_pop_if(&b, NULL);
    count = nir_if_phi(&b, count, max_count);
 
+   /* Split (mode 2, radv_task_emu_splits): a record a mesh workgroup, written in order by one
+    * invocation, each launching its own workgroup (first_workgroup) of its draw's grid. */
+   nir_push_if(&b, nir_ieq_imm(&b, mode, 2));
+   {
+      nir_push_if(&b, nir_ieq_imm(&b, global_id, 0));
+      {
+         nir_variable *split_slots = nir_local_variable_create(b.impl, glsl_uint_type(), "split_slots");
+         nir_variable *split_draw = nir_local_variable_create(b.impl, glsl_uint_type(), "split_draw");
+         nir_store_var(&b, split_slots, nir_imm_int(&b, 0), 0x1);
+         nir_store_var(&b, split_draw, nir_imm_int(&b, 0), 0x1);
+         nir_push_loop(&b);
+         {
+            nir_def *d = nir_load_var(&b, split_draw);
+            nir_break_if(&b, nir_uge(&b, d, count));
+            nir_def *grid = mesh_draw_grid(&b, d, indirect_addr, stride);
+            nir_def *g = nir_imul(&b, nir_imul(&b, nir_channel(&b, grid, 0), nir_channel(&b, grid, 1)),
+                                  nir_channel(&b, grid, 2));
+            nir_variable *split_wg = nir_local_variable_create(b.impl, glsl_uint_type(), "split_wg");
+            nir_store_var(&b, split_wg, nir_imm_int(&b, 0), 0x1);
+            nir_push_loop(&b);
+            {
+               nir_def *k = nir_load_var(&b, split_wg);
+               nir_def *slot = nir_load_var(&b, split_slots);
+               nir_break_if(&b, nir_ior(&b, nir_uge(&b, k, g), nir_uge_imm(&b, slot, 65536)));
+               mesh_draw_record(&b, slot, d, records_addr, parts, ring, nir_u2u64(&b, k), grid, task_rings,
+                                task_draw_id, nir_imm_true(&b));
+               nir_store_var(&b, split_slots, nir_iadd_imm(&b, slot, 1), 0x1);
+               nir_store_var(&b, split_wg, nir_iadd_imm(&b, k, 1), 0x1);
+            }
+            nir_pop_loop(&b, NULL);
+            nir_store_var(&b, split_draw, nir_iadd_imm(&b, d, 1), 0x1);
+         }
+         nir_pop_loop(&b, NULL);
+         nir_build_store_global(&b, nir_load_var(&b, split_slots), count_out, .align_mul = 4);
+      }
+      nir_pop_if(&b, NULL);
+   }
+   nir_push_else(&b, NULL);
    nir_push_if(&b, nir_iand(&b, nir_ieq_imm(&b, ring, 0), nir_inot(&b, compact)));
    {
       nir_push_if(&b, nir_ult(&b, global_id, count));
       {
          nir_def *grid = mesh_draw_grid(&b, global_id, indirect_addr, stride);
          mesh_draw_record(&b, global_id, global_id, records_addr, parts, ring, nir_imm_int64(&b, 0), grid, task_rings,
-                          task_draw_id);
+                          task_draw_id, NULL);
       }
       nir_pop_if(&b, NULL);
    }
@@ -1554,7 +1597,7 @@ radv_meta_nir_build_mesh_draw_records_cs(void)
 
          nir_push_if(&b, kept);
          mesh_draw_record(&b, slot, draw, records_addr, parts, ring, nir_iadd(&b, workgroups, nir_u2u64(&b, before)),
-                          grid, task_rings, task_draw_id);
+                          grid, task_rings, task_draw_id, NULL);
          nir_pop_if(&b, NULL);
 
          nir_store_var(&b, slots_var, nir_iadd(&b, slots, nir_reduce(&b, kept_1, .reduction_op = nir_op_iadd)), 0x1);
@@ -1578,6 +1621,7 @@ radv_meta_nir_build_mesh_draw_records_cs(void)
       nir_pop_if(&b, NULL);
    }
    nir_pop_if(&b, NULL);
+   nir_pop_if(&b, NULL); /* split */
 
    return b.shader;
 }
diff --git a/src/amd/vulkan/radv_cmd_buffer.c b/src/amd/vulkan/radv_cmd_buffer.c
index 5ce6c6e..ab3a65b 100644
--- a/src/amd/vulkan/radv_cmd_buffer.c
+++ b/src/amd/vulkan/radv_cmd_buffer.c
@@ -15455,7 +15455,8 @@ extern uint64_t radv_ps5_task_emu_note[8];
  * workgroups out of a chunk's mesh draw (radv_task_emu_compacts); 0x80000 gives mesh shaders no
  * late alloc, 0x200000 the full CU mask, 0x400000 a parameter export when they have none
  * (radv_precompute_registers_hw_ngg); 0x800000 draws a direct chunk's records one
- * DRAW_INDIRECT each. */
+ * DRAW_INDIRECT each; 0x1000000 leaves out the first chunk's mesh draw; 0x2000000 gives every mesh
+ * workgroup its own record and draw (radv_task_emu_splits). */
 uint32_t
 radv_ps5_task_emu_debug(void)
 {
@@ -15627,10 +15628,16 @@ radv_task_emu_dispatch(struct radv_cmd_buffer *cmd_buffer, const struct radv_tas
    }
 }
 
+bool
+radv_task_emu_splits(const struct radv_device *device, uint32_t task_rings)
+{
+   return task_rings && device->task_emu_bo && (radv_ps5_task_emu_debug() & 0x2000000);
+}
+
 bool
 radv_task_emu_compacts(const struct radv_device *device, uint32_t task_rings)
 {
-   return task_rings && device->task_emu_bo && (radv_ps5_task_emu_debug() & 0x10000);
+   return task_rings && device->task_emu_bo && (radv_ps5_task_emu_debug() & 0x10000 || radv_task_emu_splits(device, task_rings));
 }
 
 uint64_t
@@ -15672,8 +15679,13 @@ radv_task_emu_draw_chunk(struct radv_cmd_buffer *cmd_buffer, const struct radv_t
                               AC_CP_COPY_DATA_WR_CONFIRM, false);
       }
    }
-   if (!(experiments & 8) && (experiments & 0x800000) && !count_va && count <= 64 &&
-       cmd_buffer->state.uses_drawid) {
+   /* Experiment 0x1000000: the first chunk's mesh draw left out, once per process. */
+   static uint32_t chunks_drawn;
+   const bool skip_first = (experiments & 0x1000000) && p_atomic_inc_return(&chunks_drawn) == 1;
+   if (skip_first) {
+      /* nothing */
+   } else if (!(experiments & 8) && (experiments & 0x800000) && !count_va && count <= 64 &&
+       cmd_buffer->state.uses_drawid && !radv_task_emu_compacts(device, (uint32_t)emu->rings_va)) {
       /* Experiment 0x800000: a DRAW_INDIRECT per record in place of one DRAW_INDIRECT_MULTI,
        * the draw ID set by hand (the multi draw's DRAW_INDEX_ENABLE register). */
       const uint32_t draw_id_reg = cmd_buffer->state.vtx_base_sgpr + 4;
@@ -15692,7 +15704,9 @@ radv_task_emu_draw_chunk(struct radv_cmd_buffer *cmd_buffer, const struct radv_t
       /* Records left out (radv_task_emu_compacts): as many draws as the prepass kept. */
       const uint64_t draws_va = radv_task_emu_compacts(device, (uint32_t)emu->rings_va) ? radv_task_emu_count_va(device)
                                                                                          : count_va;
-      radv_cs_emit_indirect_draw_packet(cmd_buffer, false, count, draws_va, sizeof(struct radv_mesh_draw_record),
+      /* Split (radv_task_emu_splits): a draw a mesh workgroup, up to the records' room. */
+      const uint32_t draws = radv_task_emu_splits(device, (uint32_t)emu->rings_va) ? 65536 : count;
+      radv_cs_emit_indirect_draw_packet(cmd_buffer, false, draws, draws_va, sizeof(struct radv_mesh_draw_record),
                                         true);
    }
    if (experiments & 0x40) {
diff --git a/src/amd/vulkan/radv_cmd_buffer.h b/src/amd/vulkan/radv_cmd_buffer.h
index b90a16d..631ce78 100644
--- a/src/amd/vulkan/radv_cmd_buffer.h
+++ b/src/amd/vulkan/radv_cmd_buffer.h
@@ -710,6 +710,8 @@ uint32_t radv_ps5_task_emu_debug(void);
  * (radv_meta_mesh_draw_records). */
 bool radv_task_emu_compacts(const struct radv_device *device, uint32_t task_rings);
 uint64_t radv_task_emu_count_va(const struct radv_device *device);
+/* Experiment 0x2000000: a record, and a draw, per mesh workgroup. */
+bool radv_task_emu_splits(const struct radv_device *device, uint32_t task_rings);
 
 static inline uint32_t
 radv_get_num_pipeline_stat_queries(struct radv_cmd_buffer *cmd_buffer)
diff --git a/src/amd/vulkan/radv_physical_device.c b/src/amd/vulkan/radv_physical_device.c
index 25fd3ca..c864a48 100644
--- a/src/amd/vulkan/radv_physical_device.c
+++ b/src/amd/vulkan/radv_physical_device.c
@@ -395,7 +395,7 @@ radv_device_get_cache_uuid(struct radv_physical_device *pdev, void *uuid)
 #ifdef RADV_PS5
    {
       /* The mesh lowering's experiments change the code (ac_ps5_mesh_experiments). */
-      const unsigned experiments = ac_ps5_mesh_experiments() & 0x569b80;
+      const unsigned experiments = ac_ps5_mesh_experiments() & 0x2569b80;
       if (experiments)
          _mesa_blake3_update(&ctx, &experiments, sizeof(experiments));
    }
-- 
2.53.0

