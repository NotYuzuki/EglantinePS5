From 669ce39aac3fd43e3581e785fa5d9234d0fe3444 Mon Sep 17 00:00:00 2001
From: exploitizm <351399878+exploitizm@users.noreply.github.com>
Date: Fri, 6 Nov 2026 22:51:53 +1000
Subject: [PATCH] radv/ps5: log and dump each stage of a task pipeline before
 ACO

Run 22:49: the mesh-compute pipelines' shaders are of ordinary size (the
mesh shaders 1,400 to 7,900 NIR instructions, the copies 59 to 100), and
none reached its compute pass's compile: the explosion in ACO's spiller is
in one of the pipeline's own stages (task, fragment or the copy), which
radv_graphics_shaders_nir_to_asm compiles first. Each stage's size and NIR
now go out before ACO, and a line when ACO is done.
---
 src/amd/vulkan/radv_mesh_compute.c      | 12 ++++++------
 src/amd/vulkan/radv_mesh_compute.h      |  4 ++++
 src/amd/vulkan/radv_pipeline_graphics.c | 17 +++++++++++++++++
 3 files changed, 27 insertions(+), 6 deletions(-)

diff --git a/src/amd/vulkan/radv_mesh_compute.c b/src/amd/vulkan/radv_mesh_compute.c
index 91bb783..76e36d1 100644
--- a/src/amd/vulkan/radv_mesh_compute.c
+++ b/src/amd/vulkan/radv_mesh_compute.c
@@ -323,8 +323,8 @@ lower_mesh_to_compute(nir_shader *nir, const struct mesh_compute_layout *l)
 
 /* What a shader of this path has become, for the first few pipelines: its instruction count to
  * stderr and its NIR to /data/eglantineps5/logs/mesh-compute-<n>-<what>.nir. */
-static void
-dump_nir(nir_shader *nir, unsigned n, const char *what)
+void
+radv_mesh_compute_dump_nir(nir_shader *nir, unsigned n, const char *what)
 {
    unsigned instrs = 0;
    nir_foreach_function_impl (impl, nir) {
@@ -365,11 +365,11 @@ radv_mesh_compute_split(struct radv_shader_stage *stages, struct radv_mesh_compu
    l.payload_stride = align(MAX2(stages[MESA_SHADER_TASK].nir->info.task_payload_size, 16), 16);
 
    const unsigned n = p_atomic_inc_return(&dump_index) - 1;
-   dump_nir(mesh, n, "mesh-in");
+   radv_mesh_compute_dump_nir(mesh, n, "mesh-in");
    nir_shader *vs = build_copy_vs(mesh->options, &l);
    lower_mesh_to_compute(mesh, &l);
-   dump_nir(mesh, n, "lowered");
-   dump_nir(vs, n, "copy");
+   radv_mesh_compute_dump_nir(mesh, n, "lowered");
+   radv_mesh_compute_dump_nir(vs, n, "copy");
 
    memset(out, 0, sizeof(*out));
    out->mesh_stage = *ms;
@@ -437,7 +437,7 @@ radv_mesh_compute_compile(const struct radv_compiler_info *compiler_info, struct
    NIR_PASS(_, nir, nir_lower_compute_system_values, &compute_sysval_options);
    radv_optimize_nir(nir, stage.key.optimisations_disabled);
    radv_postprocess_nir(compiler_info, NULL, &stage);
-   dump_nir(nir, dump_index - 1, "final");
+   radv_mesh_compute_dump_nir(nir, dump_index - 1, "final");
 
    struct radv_shader_binary *binary = radv_shader_nir_to_asm(compiler_info, &stage, &nir, 1, NULL);
    radv_shader_dump_asm(compiler_info, debug, binary, &stage.info);
diff --git a/src/amd/vulkan/radv_mesh_compute.h b/src/amd/vulkan/radv_mesh_compute.h
index e541e9e..bedf135 100644
--- a/src/amd/vulkan/radv_mesh_compute.h
+++ b/src/amd/vulkan/radv_mesh_compute.h
@@ -47,6 +47,10 @@ struct radv_mesh_compute_split {
    uint32_t vertices_per_workgroup;
 };
 
+/* A shader's size to stderr, and its NIR to /data/eglantineps5/logs/mesh-compute-<n>-<what>.nir
+ * for n < 4. */
+void radv_mesh_compute_dump_nir(nir_shader *nir, unsigned n, const char *what);
+
 bool radv_mesh_compute_wanted(const struct radv_graphics_state_key *gfx_state,
                               const struct radv_shader_stage *stages);
 
diff --git a/src/amd/vulkan/radv_pipeline_graphics.c b/src/amd/vulkan/radv_pipeline_graphics.c
index 217faf2..463ba27 100644
--- a/src/amd/vulkan/radv_pipeline_graphics.c
+++ b/src/amd/vulkan/radv_pipeline_graphics.c
@@ -2198,7 +2198,24 @@ radv_graphics_shaders_nir_to_asm(const struct radv_compiler_info *compiler_info,
          }
       }
 
+#ifdef RADV_GS_COMPUTE
+      /* A pipeline with a task shader (radv_mesh_compute.h): each stage's size and NIR before ACO,
+       * and when ACO is done with it. */
+      static unsigned task_pipeline_stages;
+      const bool log_stage = stages[MESA_SHADER_TASK].nir && radv_mesh_compute_enabled();
+      unsigned logged = 0;
+      if (log_stage) {
+         logged = p_atomic_inc_return(&task_pipeline_stages) - 1;
+         char what[32];
+         snprintf(what, sizeof(what), "stage-%s", mesa_shader_stage_name(s));
+         radv_mesh_compute_dump_nir(nir_shaders[shader_count - 1], logged / 4, what);
+      }
+#endif
       binaries[s] = radv_shader_nir_to_asm(compiler_info, &stages[s], nir_shaders, shader_count, gfx_state);
+#ifdef RADV_GS_COMPUTE
+      if (log_stage)
+         fprintf(stderr, "radv/ps5 mesh-compute: compiled %s (%u)\n", mesa_shader_stage_name(s), logged);
+#endif
 
       /* Dump NIR after nir_to_asm, because ACO modifies it. */
       char *nir_string = NULL;
-- 
2.53.0

