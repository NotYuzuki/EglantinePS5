From 8133e4c8022b665fa25cfba827f73dedc9394118 Mon Sep 17 00:00:00 2001
From: exploitizm <351399878+exploitizm@users.noreply.github.com>
Date: Fri, 6 Nov 2026 18:30:53 +1000
Subject: [PATCH] radv/ps5: mesh experiment 0x800000, a DRAW_INDIRECT per
 record

Runs 18:23 and 18:29: a parameter export (0x400000) and the full CU mask
with no late alloc (0x280000) do not help; the same draw hangs. 0x800000
draws a direct emulated task chunk's records one DRAW_INDIRECT each (SET_BASE
at the record, the draw ID SGPR set by hand) in place of one
DRAW_INDIRECT_MULTI, to tell the multi draw from the draws themselves.
---
 src/amd/vulkan/radv_cmd_buffer.c | 19 +++++++++++++++++--
 1 file changed, 17 insertions(+), 2 deletions(-)

diff --git a/src/amd/vulkan/radv_cmd_buffer.c b/src/amd/vulkan/radv_cmd_buffer.c
index d1ca4a6..5ce6c6e 100644
--- a/src/amd/vulkan/radv_cmd_buffer.c
+++ b/src/amd/vulkan/radv_cmd_buffer.c
@@ -15454,7 +15454,8 @@ extern uint64_t radv_ps5_task_emu_note[8];
  * out of GFX10's NGG workaround; 0x10000 leaves the records of task workgroups without mesh
  * workgroups out of a chunk's mesh draw (radv_task_emu_compacts); 0x80000 gives mesh shaders no
  * late alloc, 0x200000 the full CU mask, 0x400000 a parameter export when they have none
- * (radv_precompute_registers_hw_ngg). */
+ * (radv_precompute_registers_hw_ngg); 0x800000 draws a direct chunk's records one
+ * DRAW_INDIRECT each. */
 uint32_t
 radv_ps5_task_emu_debug(void)
 {
@@ -15671,7 +15672,21 @@ radv_task_emu_draw_chunk(struct radv_cmd_buffer *cmd_buffer, const struct radv_t
                               AC_CP_COPY_DATA_WR_CONFIRM, false);
       }
    }
-   if (!(experiments & 8)) {
+   if (!(experiments & 8) && (experiments & 0x800000) && !count_va && count <= 64 &&
+       cmd_buffer->state.uses_drawid) {
+      /* Experiment 0x800000: a DRAW_INDIRECT per record in place of one DRAW_INDIRECT_MULTI,
+       * the draw ID set by hand (the multi draw's DRAW_INDEX_ENABLE register). */
+      const uint32_t draw_id_reg = cmd_buffer->state.vtx_base_sgpr + 4;
+      radv_emit_userdata_address(device, cs, mesh_shader, AC_UD_VS_MS_DRAW_RECORDS, emu->records_va);
+      for (uint32_t i = 0; i < count; i++) {
+         radeon_check_space(device->ws, cs->b, 32);
+         radv_emit_indirect_buffer(cs, emu->records_va + i * sizeof(struct radv_mesh_draw_record), false);
+         radeon_begin(cs);
+         radeon_set_sh_reg(draw_id_reg, i);
+         radeon_end();
+         radv_cs_emit_indirect_draw_packet(cmd_buffer, false, 1, 0, sizeof(struct radv_mesh_draw_record), false);
+      }
+   } else if (!(experiments & 8)) {
       radv_emit_indirect_buffer(cs, emu->records_va, false);
       radv_emit_userdata_address(device, cs, mesh_shader, AC_UD_VS_MS_DRAW_RECORDS, emu->records_va);
       /* Records left out (radv_task_emu_compacts): as many draws as the prepass kept. */
-- 
