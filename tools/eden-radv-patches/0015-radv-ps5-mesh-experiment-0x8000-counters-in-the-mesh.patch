From d3df8a0d05d08cdff9723f31c6b29167890adf9c Mon Sep 17 00:00:00 2001
From: exploitizm <351399878+exploitizm@users.noreply.github.com>
Date: Fri, 6 Nov 2026 16:01:56 +1000
Subject: [PATCH] radv/ps5: mesh experiment 0x8000, counters in the mesh shader

Run 16:00 (0x9): without the emulated mesh draws Ocarina reaches gameplay,
so they are what hangs; but nothing changed in their exports (counts,
positions, culled workgroups) moved the hang, so whether their waves end is
in doubt: a VS_PARTIAL_FLUSH passing may not say so for NGG waves.

0x8000: each mesh workgroup counts its start, and each wave its arrival at
the finale and at its end, at the end of the task emulation buffer, whose
address the records carry in place of a publish ring; the stall dump prints
the counts with the workgroup and wave sizes.
---
 src/amd/common/nir/ac_nir_lower_ngg_mesh.c  | 37 ++++++++++++++++++++-
 src/amd/vulkan/radv_cmd_buffer.c            | 17 ++++++++--
 src/amd/vulkan/radv_physical_device.c       |  2 +-
 src/amd/vulkan/winsys/ps5/radv_ps5_winsys.c | 10 ++++++
 4 files changed, 61 insertions(+), 5 deletions(-)

diff --git a/src/amd/common/nir/ac_nir_lower_ngg_mesh.c b/src/amd/common/nir/ac_nir_lower_ngg_mesh.c
index 698e9f2..afd909c 100644
--- a/src/amd/common/nir/ac_nir_lower_ngg_mesh.c
+++ b/src/amd/common/nir/ac_nir_lower_ngg_mesh.c
@@ -22,7 +22,9 @@
  * allocate one vertex and one null primitive, 0x800 has every workgroup
  * allocate and export the most vertices and primitives, those past its own
  * primitive count null, 0x1000 exports no position component that is not
- * finite. The RADV cache UUID takes the mask too. */
+ * finite, 0x8000 counts at the end of the task emulation buffer the
+ * workgroups that start, and the waves that reach the finale and its end
+ * (ms_ps5_count). The RADV cache UUID takes the mask too. */
 unsigned
 ac_ps5_mesh_experiments(void)
 {
@@ -40,6 +42,21 @@ ac_ps5_mesh_experiments(void)
    }
    return (unsigned)mask;
 }
+
+/* Experiment 0x8000: count at the ring the draw's records name in place of a
+ * publish ring (radv_task_emu_draw_chunk): dword which, once per workgroup or
+ * per wave. */
+static void
+ms_ps5_count(nir_builder *b, unsigned which, bool per_wave)
+{
+   nir_def *first = per_wave ? nir_elect(b, 1) : nir_ieq_imm(b, nir_load_local_invocation_index(b), 0);
+   nir_if *if_first = nir_push_if(b, first);
+   {
+      nir_def *addr = nir_iadd_imm(b, nir_load_ms_publish_ring_amd(b), which * 4);
+      nir_global_atomic(b, 32, addr, nir_imm_int(b, 1), .atomic_op = nir_atomic_op_iadd);
+   }
+   nir_pop_if(b, if_first);
+}
 #endif
 
 #define SPECIAL_MS_OUT_MASK \
@@ -1402,6 +1419,12 @@ emit_ms_finale(nir_builder *b, lower_ngg_ms_state *s)
    nir_block *last_block = nir_impl_last_block(b->impl);
    b->cursor = nir_after_block(last_block);
 
+#ifdef RADV_PS5
+   const bool count = (ac_ps5_mesh_experiments() & 0x8000) && !s->publish;
+   if (count)
+      ms_ps5_count(b, 1, true);
+#endif
+
    nir_barrier(b, .execution_scope=SCOPE_WORKGROUP, .memory_scope=SCOPE_WORKGROUP,
                          .memory_semantics=NIR_MEMORY_ACQ_REL,
                          .memory_modes=nir_var_shader_out|nir_var_mem_shared|(s->publish ? nir_var_mem_global : 0));
@@ -1494,6 +1517,11 @@ emit_ms_finale(nir_builder *b, lower_ngg_ms_state *s)
       emit_ms_outputs(b, invocation_index, row_start, num_prm, true, false,
                       per_primitive_outputs, &emit_ms_primitive, s);
    }
+
+#ifdef RADV_PS5
+   if (count)
+      ms_ps5_count(b, 2, true);
+#endif
 }
 
 static void
@@ -1962,6 +1990,13 @@ ac_nir_lower_ngg_mesh(nir_shader *shader, const ac_nir_lower_ngg_options *option
 
    emit_ms_finale(b, &state);
 
+#ifdef RADV_PS5
+   if ((ac_ps5_mesh_experiments() & 0x8000) && !state.publish) {
+      b->cursor = nir_before_impl(impl);
+      ms_ps5_count(b, 0, false);
+   }
+#endif
+
    if (prim_parts > 1)
       ms_confine_side_effects_to_first_part(shader, &state);
 
diff --git a/src/amd/vulkan/radv_cmd_buffer.c b/src/amd/vulkan/radv_cmd_buffer.c
index 8f72dee..7240fae 100644
--- a/src/amd/vulkan/radv_cmd_buffer.c
+++ b/src/amd/vulkan/radv_cmd_buffer.c
@@ -15515,6 +15515,13 @@ radv_task_emu_begin(struct radv_cmd_buffer *cmd_buffer, struct radv_task_emu *em
    radv_cs_add_buffer(device->ws, cmd_buffer->cs->b, device->task_emu_bo);
 
 #ifdef RADV_PS5
+   /* Experiment 0x8000: the counters start from zero, once per process. */
+   static uint32_t counters_cleared;
+   if ((radv_ps5_task_emu_debug() & 0x8000) && p_atomic_cmpxchg(&counters_cleared, 0u, 1u) == 0u) {
+      const uint32_t zero[4] = {0};
+      radeon_check_space(device->ws, cmd_buffer->cs->b, 16);
+      radv_cs_write_data(device, cmd_buffer->cs, V_371_MICRO_ENGINE, va + RADV_TASK_EMU_BYTES - 64, 4, zero, false);
+   }
    {
       const struct radv_shader *mesh = cmd_buffer->state.shaders[MESA_SHADER_MESH];
       const bool publishes = mesh && radv_ms_publishes(&mesh->info);
@@ -15523,7 +15530,8 @@ radv_task_emu_begin(struct radv_cmd_buffer *cmd_buffer, struct radv_task_emu *em
       note[2] = emu->entries;
       note[3] = stride;
       note[4] = (mesh ? mesh->info.ms.prim_parts : 0xff) | (uint64_t)publishes << 8 |
-                (uint64_t)(mesh && mesh->info.ms.has_query) << 16 | (uint64_t)task->info.cs.has_query << 24;
+                (uint64_t)(mesh && mesh->info.ms.has_query) << 16 | (uint64_t)task->info.cs.has_query << 24 |
+                (uint64_t)(mesh ? mesh->info.workgroup_size : 0) << 32 | (uint64_t)(mesh ? mesh->info.wave_size : 0) << 48;
       note[5] = (uint64_t)(cmd_buffer->state.active_occlusion_queries & 0xffff) |
                 (uint64_t)(radv_get_num_pipeline_stat_queries(cmd_buffer) & 0xffff) << 16 |
                 (uint64_t)cmd_buffer->state.active_prims_gen_queries << 32;
@@ -15624,8 +15632,11 @@ radv_task_emu_draw_chunk(struct radv_cmd_buffer *cmd_buffer, const struct radv_t
    struct radv_device *device = radv_cmd_buffer_device(cmd_buffer);
    struct radv_cmd_stream *cs = cmd_buffer->cs;
    const struct radv_shader *mesh_shader = cmd_buffer->state.shaders[MESA_SHADER_MESH];
-   const uint64_t publish_ring =
-      radv_ms_publishes(&mesh_shader->info) ? radv_buffer_get_va(device->ms_publish_ring) : 0;
+   uint64_t publish_ring = radv_ms_publishes(&mesh_shader->info) ? radv_buffer_get_va(device->ms_publish_ring) : 0;
+   /* Experiment 0x8000: the mesh shader counts at the end of the task emulation buffer
+    * (ac_ps5_mesh_experiments), which the records name in place of a publish ring. */
+   if (!publish_ring && (radv_ps5_task_emu_debug() & 0x8000))
+      publish_ring = radv_buffer_get_va(device->task_emu_bo) + RADV_TASK_EMU_BYTES - 64;
 
    radv_meta_mesh_draw_records(cmd_buffer, emu->draw_ring_va, AC_TASK_DRAW_ENTRY_BYTES, count_va, count,
                                MAX2(mesh_shader->info.ms.prim_parts, 1), publish_ring, emu->records_va,
diff --git a/src/amd/vulkan/radv_physical_device.c b/src/amd/vulkan/radv_physical_device.c
index 11982a3..1e36186 100644
--- a/src/amd/vulkan/radv_physical_device.c
+++ b/src/amd/vulkan/radv_physical_device.c
@@ -395,7 +395,7 @@ radv_device_get_cache_uuid(struct radv_physical_device *pdev, void *uuid)
 #ifdef RADV_PS5
    {
       /* The mesh lowering's experiments change the code (ac_ps5_mesh_experiments). */
-      const unsigned experiments = ac_ps5_mesh_experiments() & 0x1b80;
+      const unsigned experiments = ac_ps5_mesh_experiments() & 0x9b80;
       if (experiments)
          _mesa_blake3_update(&ctx, &experiments, sizeof(experiments));
    }
diff --git a/src/amd/vulkan/winsys/ps5/radv_ps5_winsys.c b/src/amd/vulkan/winsys/ps5/radv_ps5_winsys.c
index 3f85062..1fe89d4 100644
--- a/src/amd/vulkan/winsys/ps5/radv_ps5_winsys.c
+++ b/src/amd/vulkan/winsys/ps5/radv_ps5_winsys.c
@@ -589,6 +589,16 @@ radv_ps5_dump_task_emu(void)
                        t[3] ? (uint32_t)MIN2(t[3] / 4 * 2, 64) : 16);
    if (t[1])
       radv_ps5_dump_words("publish headers", t[1], 16);
+   /* Experiment 0x8000 (ac_ps5_mesh_experiments): mesh workgroups started, waves at the finale,
+    * waves at its end, at the end of the buffer (RADV_TASK_EMU_BYTES - 64). */
+   uint32_t counts[3];
+   const uint64_t counters = t[0] + 65536u * 64u + 65536u * 16u + (64u << 20) - 64;
+   if (radv_ps5_stall_read(counters, &counts[0]) && radv_ps5_stall_read(counters + 4, &counts[1]) &&
+       radv_ps5_stall_read(counters + 8, &counts[2]))
+      fprintf(stderr,
+              "radv/ps5 stall: mesh counters: %u workgroups started, %u waves at the finale, %u waves at its end"
+              " (workgroup %u lanes, wave %u)\n",
+              counts[0], counts[1], counts[2], (unsigned)((t[4] >> 32) & 0xffff), (unsigned)(t[4] >> 48));
    fflush(stderr);
 }
 
-- 
2.53.0

